    va_60.unlink(missing_ok=True)
    print("[PASS] Dismissal re-send queue cancellation on vendor fallback")

    # 61. Codex CLI argv JSON payload extraction in hook guard
    test_guard_61 = get_state_dir() / "test-guard-61.sh"
    test_guard_61.write_text(f'''#!/usr/bin/env bash
export HERDR_PLUGIN_STATE_DIR="{get_state_dir()}"
export HERDR_PANE_ID="w1:pCodexArgv"
{HOOK_GUARD_TEMPLATE}
echo "PASSTHROUGH_61"
''')
    test_guard_61.chmod(0o755)
    pane_61 = "w1:pCodexArgv"
    hex_61 = get_hex_pane_id(pane_61)
    va_61 = get_state_dir() / "panes" / f"{hex_61}.vendor_active"
    va_61.parent.mkdir(parents=True, exist_ok=True)
    va_61.write_text("")  # bare touch

    # Turn terminal JSON in argv $1 must pass through
    res_argv_turn = subprocess.run([str(test_guard_61), '{"session_id":"test_codex_sid_12345","hook_event_name":"agent-turn-complete"}'], stdout=subprocess.PIPE, text=True)
    assert "PASSTHROUGH_61" in res_argv_turn.stdout, "Turn-terminal event in argv JSON must pass through"
    assert va_61.exists(), "Turn-terminal event must not unlink bare touch"

    # Session terminal JSON in argv $1 must unlink vendor_active and pass through
    res_argv_sess = subprocess.run([str(test_guard_61), '{"session_id":"test_codex_sid_12345","hook_event_name":"session-end"}'], stdout=subprocess.PIPE, text=True)
    assert "PASSTHROUGH_61" in res_argv_sess.stdout, "Session-terminal event in argv JSON must pass through"
    assert not va_61.exists(), "Session-terminal event must unlink vendor_active"

    # Non-terminal JSON in argv $1 under healthy Herdr must record UUID and suppress (exit 0)
    touch_pane_marker(pane_61)
    res_argv_suppress = subprocess.run([str(test_guard_61), '{"session_id":"test_codex_sid_12345","hook_event_name":"agent-busy"}'], stdout=subprocess.PIPE, text=True)
    assert res_argv_suppress.returncode == 0
    assert "PASSTHROUGH_61" not in res_argv_suppress.stdout, "Healthy Herdr must suppress non-terminal argv JSON event"
    remove_pane_marker(pane_61)
    test_guard_61.unlink(missing_ok=True)
    va_61.unlink(missing_ok=True)
    print("[PASS] Codex CLI argv JSON payload extraction in hook guard")

    # 62. Fail-open on empty TTY without argv token/JSON
    test_guard_62 = get_state_dir() / "test-guard-62.sh"
    test_guard_62.write_text(f'''#!/usr/bin/env bash
export HERDR_PLUGIN_STATE_DIR="{get_state_dir()}"
export HERDR_PANE_ID="w1:pEmptyTty"
{HOOK_GUARD_TEMPLATE}
echo "PASSTHROUGH_62"
''')
    test_guard_62.chmod(0o755)
    pane_62 = "w1:pEmptyTty"
    touch_pane_marker(pane_62)
    # Empty stdin over pipe with no argv -> must fail-open to vendor hook
    res_empty_pipe = subprocess.run([str(test_guard_62)], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True)
    assert res_empty_pipe.returncode == 0
    assert "PASSTHROUGH_62" in res_empty_pipe.stdout, "Empty stdin without argv must fail-open"
    remove_pane_marker(pane_62)
    test_guard_62.unlink(missing_ok=True)
    print("[PASS] Fail-open on empty TTY without argv token/JSON")

    # 63. Hung sender lease takeover race defeated by resync_generation
    sid_63 = f"herdr:{host_test}:w1:pHungLease"
    with cache_mgr as data:
        data.get("sessions", {})[sid_63] = {
            "state": "Working",
            "desired_state": "Working",
            "seq": 1,
            "resync_generation": 0,
            "pane_id": "w1:pHungLease",
            "agent": "claude",
        }
        cache_mgr.save(data)

    # Sender 1 starts with my_resync_gen = 0
    my_token_1 = f"99999:{PROCESS_START_TIME}:{time.time()}:{sid_63}"
    my_resync_gen_1 = 0
    with cache_mgr as data:
        s = data.get("sessions", {}).get(sid_63)
        s["lease_token"] = my_token_1

    # While Sender 1 is sending, reconciler / Sender 2 supersedes lease
    my_token_2 = f"{os.getpid()}:{PROCESS_START_TIME}:{time.time()}:{sid_63}"
    with cache_mgr as data:
        s = data.get("sessions", {}).get(sid_63)
        s["lease_token"] = my_token_2
        s["seq"] = 2
        s["desired_state"] = "Waiting"

    # Sender 1 returns to Step C and detects lease token mismatch: it bumps resync_generation
    with cache_mgr as data:
        s = data.get("sessions", {}).get(sid_63)
        if s.get("lease_token") != my_token_1:
            s["resync_generation"] = s.get("resync_generation", 0) + 1
            s["delivered_seq"] = 0
            s["delivery_status"] = "in_flight"
        cache_mgr.save(data)

    # Sender 2 now returns to Step C with success=True, but my_resync_gen was 0.
    # Because resync_generation (1) > my_resync_gen (0), Sender 2 must NOT mark delivered;
    # it must force re-sync.
    with cache_mgr as data:
        s = data.get("sessions", {}).get(sid_63)
        if s.get("resync_generation", 0) > my_resync_gen_1:
            s["delivered_seq"] = 0
            s["delivery_status"] = "in_flight"
        else:
            s["delivered_seq"] = 2
            s["delivery_status"] = "delivered"
        cache_mgr.save(data)

    with cache_mgr as data:
        s = data.get("sessions", {}).get(sid_63)
        assert s.get("delivery_status") == "in_flight", "Superseded resync_generation must force in_flight re-sync"
        assert s.get("delivered_seq") == 0
        data.get("sessions", {}).pop(sid_63, None)
        cache_mgr.save(data)
    print("[PASS] Hung sender lease takeover race defeated by resync_generation")

    # 64. Reconciler Ended confirmation preserving Step A origins without event_data/arr_ns
    pane_64 = "w1:pOriginTest"
    sid_64 = f"herdr:{host_test}:{pane_64}"
    orig_closed_at_ns = time.time_ns() - 5_000_000_000
    orig_closed_source_ts = 12345.67
    orig_last_source_ts = 12340.0
    with cache_mgr as data:
        data.get("sessions", {})[sid_64] = {
            "state": "Working",
            "desired_state": "Ended",
            "seq": 2,
            "close_kind": "container",
            "pane_id": pane_64,
            "agent": "claude",
            "closed_at_ns": orig_closed_at_ns,
            "closed_source_ts": orig_closed_source_ts,
            "last_source_timestamp": orig_last_source_ts,
        }
        cache_mgr.save(data)

    reconcile_active_sessions(get_state_dir(), bridge_url=mock_url)
    with cache_mgr as data:
        assert sid_64 not in data.get("sessions", {}), "Ended session must be evicted on reconcile delivery"
        assert pane_64 in data.get("tombstones", {}), "Tombstone must be created on container Ended reconcile"
        t_entry = data["tombstones"][pane_64]
        assert t_entry["closed_at_ns"] == orig_closed_at_ns, "Tombstone closed_at_ns must match Step A origin"
        assert t_entry["closed_source_ts"] == orig_closed_source_ts, "Tombstone closed_source_ts must match Step A origin"
        assert t_entry["last_source_timestamp"] == orig_last_source_ts, "Tombstone last_source_timestamp must match Step A origin"
        data.get("tombstones", {}).pop(pane_64, None)
        cache_mgr.save(data)
    print("[PASS] Reconciler Ended confirmation preserving Step A origins without event_data/arr_ns")

    # 65. Reconciler settling window retries for dismissed_vendor_uuids
    v_uuid_65 = "vendor_settle_uuid_99999"
    pane_65 = "w1:pSettle"
    hex_65 = get_hex_pane_id(pane_65)
    t_start = time.time()
    with cache_mgr as data:
        data.setdefault("dismissed_vendor_uuids", {})[v_uuid_65] = {
            "timestamp": t_start - 3.0,
            "pane_hex": hex_65,
            "attempts": 1,
            "last_attempt": t_start - 3.0,
        }
        cache_mgr.save(data)

    # First reconcile cycle: elapsed 3s (< 10s), attempts 1 (< 3), interval 3s (>= 2s)
    # Must post Ended and increment attempts to 2, retaining entry in dismissed_vendor_uuids
    MockBartenderHandler.sessions[v_uuid_65] = {"state": "Working"}
    reconcile_active_sessions(get_state_dir(), bridge_url=mock_url)
    with cache_mgr as data:
        assert v_uuid_65 in data.get("dismissed_vendor_uuids", {}), "Entry must be retained across retry in settling window"
        meta_65 = data["dismissed_vendor_uuids"][v_uuid_65]
        assert meta_65.get("attempts") == 2, "Attempts must be incremented"
        # Simulate settling window expiry (11s elapsed)
        meta_65["timestamp"] = time.time() - 11.0
        cache_mgr.save(data)

    # Second reconcile cycle: elapsed >= 10s -> entry purged
    reconcile_active_sessions(get_state_dir(), bridge_url=mock_url)
    with cache_mgr as data:
        assert v_uuid_65 not in data.get("dismissed_vendor_uuids", {}), "Entry must be purged after settling window elapsed"
    print("[PASS] Reconciler settling window retries for dismissed_vendor_uuids")

    # 66. Normative STATE_DIR resolution parity across Python and Bash
    norm_bash_cmd = 'printf "%s" "${HERDR_PLUGIN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr/plugins/herdr-bartender}"'

    # Case 1: HERDR_PLUGIN_STATE_DIR set
    os.environ["HERDR_PLUGIN_STATE_DIR"] = "/tmp/test_herdr_plugin_state"
    os.environ.pop("XDG_STATE_HOME", None)
    py_dir_1 = str(get_state_dir())
    bash_dir_1 = subprocess.check_output(["bash", "-c", norm_bash_cmd], text=True)
    assert py_dir_1 == bash_dir_1 == "/tmp/test_herdr_plugin_state", f"Case 1 mismatch: py={py_dir_1}, bash={bash_dir_1}"

    # Case 2: XDG_STATE_HOME set, HERDR_PLUGIN_STATE_DIR unset
    os.environ.pop("HERDR_PLUGIN_STATE_DIR", None)
    os.environ["XDG_STATE_HOME"] = "/tmp/test_xdg_home"
    py_dir_2 = str(get_state_dir())
    bash_dir_2 = subprocess.check_output(["bash", "-c", norm_bash_cmd], text=True)
    assert py_dir_2 == bash_dir_2 == "/tmp/test_xdg_home/herdr/plugins/herdr-bartender", f"Case 2 mismatch: py={py_dir_2}, bash={bash_dir_2}"

    # Case 3: Both unset (default $HOME/.local/state)
    os.environ.pop("HERDR_PLUGIN_STATE_DIR", None)
    os.environ.pop("XDG_STATE_HOME", None)
    py_dir_3 = str(get_state_dir())
    bash_dir_3 = subprocess.check_output(["bash", "-c", norm_bash_cmd], text=True)
    expected_3 = str(Path.home() / ".local" / "state" / "herdr" / "plugins" / "herdr-bartender")
    assert py_dir_3 == bash_dir_3 == expected_3, f"Case 3 mismatch: py={py_dir_3}, bash={bash_dir_3}"

    # Restore test state dir
    os.environ["HERDR_PLUGIN_STATE_DIR"] = str(state_dir)
    print("[PASS] Normative STATE_DIR resolution parity across Python and Bash")

    # 67. Turn-terminal pass-through under UUID-bearing .vendor_active
    test_guard_67 = get_state_dir() / "test-guard-67.sh"
    test_guard_67.write_text(f'''#!/usr/bin/env bash
export HERDR_PLUGIN_STATE_DIR="{get_state_dir()}"
export HERDR_PANE_ID="w1:pTurnPassUUID"
{HOOK_GUARD_TEMPLATE}
echo "PASSTHROUGH_67"
''')
    test_guard_67.chmod(0o755)
    pane_67 = "w1:pTurnPassUUID"
    hex_67 = get_hex_pane_id(pane_67)
    touch_pane_marker(pane_67)
    va_67 = get_state_dir() / "panes" / f"{hex_67}.vendor_active"
    va_67.parent.mkdir(parents=True, exist_ok=True)
    va_67.write_text('{"vendor_session_id":"test_uuid_turn_67"}')

    # Turn-terminal event must pass through even under healthy Herdr
    res_turn_67 = subprocess.run([str(test_guard_67), "Stop"], stdout=subprocess.PIPE, text=True)
    assert res_turn_67.returncode == 0
    assert "PASSTHROUGH_67" in res_turn_67.stdout, "Turn-terminal event under UUID record must pass through"
    assert va_67.exists(), ".vendor_active must be retained after turn-terminal pass-through"

    # Non-terminal event under healthy Herdr must be suppressed (exit 0 without passthrough)
    res_non_turn_67 = subprocess.run([str(test_guard_67), "Working"], stdout=subprocess.PIPE, text=True)
    assert res_non_turn_67.returncode == 0
    assert "PASSTHROUGH_67" not in res_non_turn_67.stdout, "Non-terminal event under healthy Herdr must be suppressed"

    remove_pane_marker(pane_67)
    va_67.unlink(missing_ok=True)
    test_guard_67.unlink(missing_ok=True)
    print("[PASS] Turn-terminal pass-through under UUID-bearing .vendor_active")

    # 68. Active notification and degraded mode on HOOK_NEEDS_REVIEW
    hnr_test = get_state_dir() / "HOOK_NEEDS_REVIEW"
    alerted_test = get_state_dir() / ".hook_review_alerted"
    hnr_test.unlink(missing_ok=True)
    alerted_test.unlink(missing_ok=True)

    # Simulate reconcile hook review creation
    hnr_test.touch()
    alerted_test.touch()
    assert hnr_test.exists() and alerted_test.exists()

    # Explicit install_hooks clears both flags
    install_hooks()
    assert not hnr_test.exists(), "install_hooks must unlink HOOK_NEEDS_REVIEW"
    assert not alerted_test.exists(), "install_hooks must unlink .hook_review_alerted"
    print("[PASS] Active notification and degraded mode on HOOK_NEEDS_REVIEW")

    server.shutdown()
    print("=== ALL COMPREHENSIVE UNIT TESTS PASSED ===")


def run_live_test():
    print(f"Checking Bartender bridge at {get_bridge_url()}...")
    health = check_bridge_health()
    if not health:
        print("[-] Error: Bartender bridge not reachable. Make sure Bartender 6 is running with Top Shelf enabled.")
        sys.exit(1)
    print(f"[+] Bartender bridge is healthy: {health}")

    host = get_sanitized_hostname()
    test_session = f"herdr:{host}:test_workspace:test_pane_1"
    print("\n1. Emitting 'Working' state...")
    post_bartender_event({
        "state": "Working",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
        "title": "Unit test running in Herdr",
        "terminal": "Herdr",
    })
    print("   Sent Working. Top Shelf should show active spinner.")

    time.sleep(1.0)

    print("\n2. Emitting 'Waiting' state (Awaiting input / attention)...")
    post_bartender_event({
        "state": "Waiting",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
        "title": "Awaiting user confirmation in Herdr",
        "terminal": "Herdr",
    })
    print("   Sent Waiting. Top Shelf NotchBar should highlight attention banner.")

    time.sleep(1.0)

    print("\n3. Emitting 'Done' state...")
    post_bartender_event({
        "state": "Done",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
        "title": "Task completed successfully",
        "terminal": "Herdr",
    })
    print("   Sent Done. Top Shelf should show completion.")

    time.sleep(1.0)

    print("\n4. Emitting 'Ended' state (Pane closed)...")
    post_bartender_event({
        "state": "Ended",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
    })
    print("   Sent Ended. Session removed from Top Shelf.")

    final_health = check_bridge_health()
    print(f"\n[+] Live test complete! Final bridge health: {final_health}")


def main():
    args = sys.argv[1:]

    if "--unit-test" in args:
        run_unit_tests()
        return

    if "--test" in args:
        run_live_test()
        return

    if "--health" in args:
        h = check_bridge_health()
        result = h or {"error": "unreachable"}
        hooks_ok, missing = verify_vendor_hooks_intact()
        result["hooks_guard_intact"] = hooks_ok
        if missing:
            result["hooks_guard_missing"] = missing
        print(json.dumps(result, indent=2))
        return

    if "--status" in args:
        state_dir = get_state_dir()
        if (state_dir / "HOOK_NEEDS_REVIEW").exists():
            print("[WARNING] Vendor hook modified upstream (SHA mismatch). Run 'herdr-bartender --install-hooks' to re-verify and approve changes.")
        cache_mgr = BoundedSessionCache(state_dir)
        with cache_mgr as data:
            sessions = data.get("sessions", {})
            print(f"Active sessions: {len(sessions)}")
            for sid, s in sessions.items():
                print(f"  {sid}: state={s.get('desired_state')} status={s.get('delivery_status')}")
        return

    if "--install-hooks" in args:
        ok = install_hooks()
        sys.exit(0 if ok else 1)

    if "--uninstall-hooks" in args:
        ok = uninstall_hooks()
        sys.exit(0 if ok else 1)

    if "--cleanup" in args:
        code = run_cleanup()
        sys.exit(code)

    if "--replay-orphans" in args:
        idx = args.index("--replay-orphans")
        if idx + 1 < len(args):
            orphan_file = args[idx + 1]
            ok = run_replay_orphans(orphan_file)
            sys.exit(0 if ok else 1)
        else:
            print("Usage: --replay-orphans <path-to-orphan-file>")
            sys.exit(1)

    if "--sessions" in args:
        cache_mgr = BoundedSessionCache(get_state_dir())
        with cache_mgr as data:
            print(json.dumps(data, indent=2))
        return

    if "--reconcile-background" in args:
        run_reconcile_background()
        return

    if is_disabled():
        sys.exit(0)

    # Normal Herdr event dispatch
    arm_watchdog()
    touch_heartbeat()
    event_name = os.environ.get("HERDR_PLUGIN_EVENT", "")
    event_json_raw = os.environ.get("HERDR_PLUGIN_EVENT_JSON", "{}")
    context_json_raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON", "{}")

    try:
        envelope = json.loads(event_json_raw)
    except Exception:
        envelope = {}

    try:
        context = json.loads(context_json_raw)
    except Exception:
        context = {}

    data = envelope.get("data", {})

    if event_name == "pane.agent_status_changed":
        handle_agent_status_changed(data, context, arrival_time=PROCESS_ARRIVAL_TIME, arrival_ns=PROCESS_ARRIVAL_TIME_NS)
    elif event_name == "pane.closed":
        handle_pane_closed(data, context, arrival_ns=PROCESS_ARRIVAL_TIME_NS)
    elif event_name == "tab.closed":
        handle_tab_closed(data, context, arrival_ns=PROCESS_ARRIVAL_TIME_NS)
    elif event_name == "workspace.closed":
        handle_workspace_closed(data, context, arrival_ns=PROCESS_ARRIVAL_TIME_NS)


if __name__ == "__main__":
    main()
