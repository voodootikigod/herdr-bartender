#!/usr/bin/env python3
"""
herdr-bartender: Herdr plugin to synchronize agent status and pane notifications
into Bartender Pro's Top Shelf (NotchBar) HTTP bridge.
"""

import sys
import os
import json
import socket
import re
import fcntl
import time
import signal
import urllib.request
import urllib.error
from pathlib import Path
from http.server import HTTPServer, ThreadingHTTPServer, BaseHTTPRequestHandler
import threading
import subprocess

DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 7823
PROCESS_DEADLINE_SECONDS = 1.4

AGENT_NAME_OVERRIDES = {
    "claude": "Claude",
    "codex": "Codex",
    "kilo": "Kilo",
    "grok": "Grok",
    "cursor": "Cursor",
    "copilot": "Copilot",
    "kimi": "Kimi",
    "opencode": "OpenCode",
}

STATUS_MAP = {
    "blocked": "Waiting",   # Awaiting user input / permission -> NotchBar highlight
    "working": "Working",   # Turn or tool running
    "done": "Done",         # Completed
    "idle": "Idle",         # Idle at prompt
}

CSI_REGEX = re.compile(r'\x1b\[[0-9;]*[a-zA-Z]')
OSC_REGEX = re.compile(r'\x1b\][^\x07\x1b]*(\x07|\x1b\\)')
DCS_REGEX = re.compile(r'\x1bP[^\x1b]*\x1b\\')
CONTROL_REGEX = re.compile(r'[\x00-\x1f\x7f-\x9f]')
PANE_ID_REGEX = re.compile(r'^[a-zA-Z0-9_:-]{1,48}$')
CONTAINER_ID_REGEX = re.compile(r'^[a-zA-Z0-9_:-]{1,48}$')

START_TIME = time.monotonic()
PROCESS_ARRIVAL_TIME = time.time()
IN_CRITICAL_SECTION = False
PENDING_WATCHDOG_EXIT = False


def get_state_dir() -> Path:
    state_env = os.environ.get("HERDR_PLUGIN_STATE_DIR")
    if state_env:
        p = Path(state_env)
    else:
        xdg_state = os.environ.get("XDG_STATE_HOME")
        if xdg_state:
            p = Path(xdg_state) / "herdr" / "plugins" / "herdr-bartender"
        else:
            p = Path.home() / ".local" / "state" / "herdr" / "plugins" / "herdr-bartender"
    p.mkdir(parents=True, exist_ok=True)
    return p


def get_sanitized_hostname() -> str:
    raw = socket.gethostname().split('.')[0].lower()
    clean = re.sub(r'[^a-z0-9_-]', '', raw)
    return clean or "local"


def get_bridge_url() -> str:
    port = os.environ.get("NOTCHBAR_AGENTS_PORT") or str(DEFAULT_PORT)
    return f"http://127.0.0.1:{port}"


def time_remaining() -> float:
    elapsed = time.monotonic() - START_TIME
    rem = PROCESS_DEADLINE_SECONDS - elapsed
    return max(0.1, rem)


def _timeout_watchdog(signum, frame):
    global PENDING_WATCHDOG_EXIT
    if IN_CRITICAL_SECTION:
        PENDING_WATCHDOG_EXIT = True
        return
    log_debug("Watchdog deadline exceeded (SIGALRM)")
    # Non-blocking handoff to background helper before exit
    try:
        cache_file = get_state_dir() / "active-sessions.json"
        if cache_file.exists():
            with open(cache_file, "r") as f:
                d = json.load(f)
                for s in d.get("sessions", {}).values():
                    if s.get("delivered_seq", 0) < s.get("seq", 0) or s.get("desired_state") == "Ended":
                        subprocess.Popen(
                            [sys.executable, str(Path(__file__).resolve()), "--reconcile-background"],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            start_new_session=True,
                        )
                        break
    except Exception:
        pass
    sys.exit(0)


def arm_watchdog():
    if hasattr(signal, "SIGALRM"):
        try:
            signal.signal(signal.SIGALRM, _timeout_watchdog)
            if hasattr(signal, "setitimer"):
                signal.setitimer(signal.ITIMER_REAL, PROCESS_DEADLINE_SECONDS)
        except Exception:
            pass


def is_pid_alive(pid: int | None) -> bool:
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def is_disabled() -> bool:
    try:
        return (get_state_dir() / "DISABLED").exists()
    except Exception:
        return False


def is_herdr_alive() -> bool:
    try:
        res = subprocess.run(["pgrep", "-xi", "herdr"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return res.returncode == 0
    except Exception:
        return False


HOOK_GUARD_TEMPLATE = """# BEGIN HERDR-BARTENDER DEDUP GUARD
if [ -n "${HERDR_PANE_ID:-}" ]; then
  STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/herdr/plugins/herdr-bartender"
  # Guard check: suppress vendor hook only if healthy, active, and delivering
  if [ ! -f "$STATE_HOME/DISABLED" ] && [ ! -f "$STATE_HOME/DELIVERY_DOWN" ]; then
    HEX_PANE=$(printf '%s' "$HERDR_PANE_ID" | od -An -tx1 | tr -d ' \\n')
    PANE_MARKER="$STATE_HOME/panes/${HEX_PANE}"
    if [ -f "$PANE_MARKER" ] && [ ! -f "${PANE_MARKER}.failed" ] && pgrep -xi "herdr" >/dev/null 2>&1; then
      exit 0
    fi
  fi
fi
# END HERDR-BARTENDER DEDUP GUARD"""


def touch_pane_failed(pane_id: str):
    if not pane_id or is_disabled():
        return
    try:
        panes_dir = get_state_dir() / "panes"
        panes_dir.mkdir(parents=True, exist_ok=True)
        hex_id = get_hex_pane_id(pane_id)
        failed_path = panes_dir / f"{hex_id}.failed"
        with open(failed_path, "w", encoding="utf-8") as f:
            f.write(str(int(time.time())))
        marker_path = panes_dir / hex_id
        if marker_path.exists():
            marker_path.unlink()
    except Exception:
        pass


def clear_pane_failed(pane_id: str):
    if not pane_id:
        return
    try:
        hex_id = get_hex_pane_id(pane_id)
        failed = get_state_dir() / "panes" / f"{hex_id}.failed"
        if failed.exists():
            failed.unlink()
    except Exception:
        pass


def touch_delivery_down():
    try:
        (get_state_dir() / "DELIVERY_DOWN").touch(exist_ok=True)
    except Exception:
        pass


def clear_delivery_down():
    try:
        flag = get_state_dir() / "DELIVERY_DOWN"
        if flag.exists():
            flag.unlink()
    except Exception:
        pass


def is_delivery_down() -> bool:
    try:
        return (get_state_dir() / "DELIVERY_DOWN").exists()
    except Exception:
        return False


def get_vendor_hooks_dir() -> Path:
    return Path.home() / "Library" / "Application Support" / "Bartender" / "NotchBar" / "AgentStatus" / "hooks"


def verify_vendor_hooks_intact() -> tuple[bool, list[str]]:
    hooks_dir = get_vendor_hooks_dir()
    if not hooks_dir.exists():
        return False, []
    hook_files = sorted(hooks_dir.glob("*.sh"))
    if not hook_files:
        return False, []
    missing = []
    for hf in hook_files:
        try:
            with open(hf, "r", encoding="utf-8") as f:
                content = f.read()
            if "# BEGIN HERDR-BARTENDER DEDUP GUARD" not in content or "# END HERDR-BARTENDER DEDUP GUARD" not in content:
                missing.append(hf.name)
        except Exception:
            missing.append(hf.name)
    return (len(missing) == 0), missing


def install_hooks() -> bool:
    import hashlib
    hooks_dir = get_vendor_hooks_dir()
    if not hooks_dir.exists():
        print(f"[-] Vendor hooks directory not found: {hooks_dir}")
        return False

    hook_files = sorted(hooks_dir.glob("*.sh"))
    if not hook_files:
        print(f"[-] No hook scripts found in {hooks_dir}")
        return False

    state_dir = get_state_dir()
    sha_file = state_dir / "vendor-hook-sha.json"
    sha_cache = {}
    if sha_file.exists():
        try:
            with open(sha_file, "r", encoding="utf-8") as f:
                sha_cache = json.load(f)
        except Exception:
            sha_cache = {}

    all_ok = True
    begin_marker = "# BEGIN HERDR-BARTENDER DEDUP GUARD"
    end_marker = "# END HERDR-BARTENDER DEDUP GUARD"

    for hook in hook_files:
        try:
            with open(hook, "r", encoding="utf-8") as f:
                content = f.read()

            if begin_marker in content and end_marker in content:
                pre = content.split(begin_marker)[0]
                post = content.split(end_marker)[1]
                new_content = f"{pre}{HOOK_GUARD_TEMPLATE}{post}"
            else:
                bak_path = hook.with_suffix(hook.suffix + ".pre-install.bak")
                if not bak_path.exists():
                    with open(bak_path, "w", encoding="utf-8") as bf:
                        bf.write(content)
                    sha_cache[hook.name] = hashlib.sha256(content.encode("utf-8")).hexdigest()

                lines = content.splitlines(keepends=True)
                insert_idx = 0
                for idx, line in enumerate(lines):
                    if line.strip() == "set -u":
                        insert_idx = idx + 1
                        break
                    elif line.startswith("#!") and insert_idx == 0:
                        insert_idx = idx + 1

                new_lines = lines[:insert_idx] + [f"\n{HOOK_GUARD_TEMPLATE}\n"] + lines[insert_idx:]
                new_content = "".join(new_lines)

            tmp_path = hook.with_suffix(f"{hook.suffix}.tmp.{os.getpid()}")
            with open(tmp_path, "w", encoding="utf-8") as tf:
                tf.write(new_content)

            check = subprocess.run(["bash", "-n", str(tmp_path)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if check.returncode != 0:
                print(f"[-] Syntax validation failed for {hook.name}: {check.stderr.decode('utf-8')}")
                tmp_path.unlink(missing_ok=True)
                all_ok = False
                continue

            os.replace(tmp_path, hook)
            print(f"[+] Installed dedup guard in {hook.name}")
        except Exception as e:
            print(f"[-] Error installing guard in {hook.name}: {e}")
            all_ok = False

    try:
        with open(sha_file, "w", encoding="utf-8") as f:
            json.dump(sha_cache, f, indent=2)
    except Exception:
        pass

    return all_ok


def get_hex_pane_id(raw_id: str | None) -> str:
    if not raw_id:
        return "default"
    return str(raw_id).encode("utf-8").hex()


def touch_heartbeat():
    if is_disabled():
        return
    try:
        marker = get_state_dir() / "plugin-active"
        marker.touch(exist_ok=True)
    except Exception:
        pass


def remove_heartbeat():
    try:
        marker = get_state_dir() / "plugin-active"
        if marker.exists():
            marker.unlink()
    except Exception:
        pass


def touch_pane_marker(pane_id: str):
    if not pane_id or is_disabled():
        return
    try:
        panes_dir = get_state_dir() / "panes"
        panes_dir.mkdir(parents=True, exist_ok=True)
        hex_id = get_hex_pane_id(pane_id)
        marker_path = panes_dir / hex_id
        with open(marker_path, "w", encoding="utf-8") as f:
            f.write(str(int(time.time())))
        failed_path = panes_dir / f"{hex_id}.failed"
        if failed_path.exists():
            failed_path.unlink()
    except Exception:
        pass


def remove_pane_marker(pane_id: str):
    if not pane_id:
        return
    try:
        hex_id = get_hex_pane_id(pane_id)
        marker = get_state_dir() / "panes" / hex_id
        if marker.exists():
            marker.unlink()
        failed = get_state_dir() / "panes" / f"{hex_id}.failed"
        if failed.exists():
            failed.unlink()
    except Exception:
        pass


def log_debug(msg: str):
    try:
        log_file = get_state_dir() / "plugin.log"
        with open(log_file, "a", encoding="utf-8") as f:
            f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")
    except Exception:
        pass


def post_bartender_event(payload: dict, timeout: float = 0.5, bridge_url: str | None = None) -> tuple[bool, bool]:
    """Posts event to Bartender Pro bridge. Returns (success: bool, is_non_retryable: bool)."""
    eff_timeout = min(timeout, time_remaining())
    url = f"{bridge_url or get_bridge_url()}/event"
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=eff_timeout) as resp:
            if resp.status == 200:
                try:
                    res_body = json.loads(resp.read().decode("utf-8", errors="ignore"))
                    if res_body.get("ok") is True:
                        return (True, False)
                    # 200 with ok:false is non-retryable bridge rejection
                    return (False, True)
                except Exception:
                    return (True, False)
            elif 300 <= resp.status < 500:
                return (False, True)
            else:
                return (False, False)
    except urllib.error.HTTPError as e:
        log_debug(f"HTTPError {e.code} posting to {url}: {e}")
        if 300 <= e.code < 500:
            return (False, True)
        return (False, False)
    except Exception as e:
        log_debug(f"Failed to post event to {url}: {e}")
        return (False, False)


def check_bridge_health(timeout: float = 0.6, bridge_url: str | None = None) -> dict | None:
    eff_timeout = min(timeout, time_remaining())
    url = f"{bridge_url or get_bridge_url()}/health"
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=eff_timeout) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8", errors="ignore"))
    except Exception as e:
        log_debug(f"Health check failed for {url}: {e}")
    return None


class BoundedSessionCache:
    """Thread/Process-safe session cache with non-blocking bounded locking and quarantine."""

    def __init__(self, state_dir: Path):
        self.state_dir = state_dir
        self.cache_file = state_dir / "active-sessions.json"
        self.lock_file = state_dir / "active-sessions.lock"
        self._lock_fd = None

    def __enter__(self):
        self._lock_fd = os.open(str(self.lock_file), os.O_CREAT | os.O_RDWR, 0o600)
        # Bounded acquisition with backoff up to 200ms
        deadline = time.monotonic() + 0.2
        acquired = False
        while time.monotonic() < deadline:
            try:
                fcntl.flock(self._lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                acquired = True
                break
            except (IOError, OSError):
                time.sleep(0.01)
        if not acquired:
            log_debug("Warning: lock contention exceeded 200ms, proceeding with best effort")
        return self._load()

    def __exit__(self, exc_type, exc_val, exc_tb):
        try:
            if self._lock_fd is not None:
                fcntl.flock(self._lock_fd, fcntl.LOCK_UN)
                os.close(self._lock_fd)
        except Exception:
            pass

    def _load(self) -> dict:
        if not self.cache_file.exists():
            return {
                "version": 1,
                "host": get_sanitized_hostname(),
                "sessions": {},
                "last_successful_delivery": 0.0,
                "consecutive_failures": 0,
            }
        try:
            with open(self.cache_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                if not isinstance(data, dict) or "sessions" not in data:
                    raise ValueError("Malformed cache structure")
                return data
        except Exception as e:
            log_debug(f"Quarantining corrupt cache: {e}")
            salvaged = {}
            try:
                # Best-effort salvage of candidate session IDs from corrupt raw text
                try:
                    with open(self.cache_file, "r", encoding="utf-8", errors="ignore") as cf:
                        raw_text = cf.read()
                        matches = re.findall(r'herdr:[a-zA-Z0-9_-]+:[a-zA-Z0-9_:-]+', raw_text)
                        now_salvage = time.time()
                        for m in set(matches):
                            parts = m.split(":")
                            pane_id = ":".join(parts[2:]) if len(parts) >= 3 else parts[-1]
                            ws_id = pane_id.split(":", 1)[0] if ":" in pane_id else None
                            salvaged[m] = {
                                "pane_id": pane_id,
                                "workspace_id": ws_id,
                                "tab_id": None,
                                "host": parts[1] if len(parts) >= 2 else get_sanitized_hostname(),
                                "agent": "Herdr",
                                "raw_agent": None,
                                "title": f"Salvaged Session {pane_id}",
                                "cwd": "",
                                "desired_state": "Idle",
                                "delivered_state": "Idle",
                                "seq": 1,
                                "delivered_seq": 1,
                                "rejected_seq": 0,
                                "desired_payload": None,
                                "delivery_status": "salvaged",
                                "delivery_error": None,
                                "delivery_attempts": 0,
                                "salvaged": True,
                                "last_event_at": now_salvage,
                                "last_applied_arrival_time": now_salvage,
                            }
                except Exception:
                    pass
                corrupt_path = self.state_dir / f"active-sessions.json.corrupt.{int(time.time())}"
                self.cache_file.replace(corrupt_path)
            except Exception:
                pass
            return {
                "version": 1,
                "host": get_sanitized_hostname(),
                "sessions": salvaged,
                "last_successful_delivery": 0.0,
                "consecutive_failures": 0,
            }

    def save(self, data: dict):
        global IN_CRITICAL_SECTION
        IN_CRITICAL_SECTION = True
        try:
            data["last_updated"] = time.time()
            data["host"] = get_sanitized_hostname()
            tmp_path = self.state_dir / f"active-sessions.json.tmp.{os.getpid()}"
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp_path, self.cache_file)
        except Exception as e:
            log_debug(f"Error saving cache: {e}")
        finally:
            IN_CRITICAL_SECTION = False
            if PENDING_WATCHDOG_EXIT:
                log_debug("Exiting cleanly after deferred watchdog deadline")
                sys.exit(0)


def sanitize_title(raw: str | None) -> str:
    if not raw:
        return ""
    text = str(raw)
    text = OSC_REGEX.sub('', text)
    text = DCS_REGEX.sub('', text)
    text = CSI_REGEX.sub('', text)
    text = CONTROL_REGEX.sub('', text)
    return text.strip()[:120]


def format_agent_name(raw_agent: str | None) -> str:
    if not raw_agent or not raw_agent.strip():
        return "Herdr"
    clean = raw_agent.strip().lower()
    pretty = AGENT_NAME_OVERRIDES.get(clean, clean.capitalize())
    return f"{pretty} (Herdr)"


def normalize_pane_id(raw_pane_id: str, workspace_id: str | None) -> str:
    if ":" in raw_pane_id:
        return raw_pane_id
    ws = workspace_id or "w1"
    return f"{ws}:{raw_pane_id}"


def enqueue_spool(event_name: str, event_data: dict, context: dict, arrival_time: float | None = None):
    try:
        spool_dir = get_state_dir() / "spool"
        spool_dir.mkdir(parents=True, exist_ok=True)
        arr_time = arrival_time or PROCESS_ARRIVAL_TIME
        envelope = {
            "event_name": event_name,
            "event_data": event_data,
            "context": context,
            "arrival_time": arr_time,
            "enqueued_at": time.time(),
            "enqueued_ns": time.time_ns(),
        }
        filename = f"{time.time_ns():020d}_{os.getpid()}.json"
        tmp_file = spool_dir / f"{filename}.tmp"
        final_file = spool_dir / filename
        with open(tmp_file, "w", encoding="utf-8") as f:
            json.dump(envelope, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_file, final_file)
    except Exception as e:
        log_debug(f"Failed to enqueue spool: {e}")


def replay_spool_dir(state_dir: Path, bridge_url: str | None = None, max_batch: int = 5):
    spool_dir = state_dir / "spool"
    if not spool_dir.exists():
        return
    files = sorted(spool_dir.glob("*.json"))
    for file_path in files[:max_batch]:
        try:
            with open(file_path, "r", encoding="utf-8") as f:
                envelope = json.load(f)
            ename = envelope.get("event_name", "")
            edata = envelope.get("event_data", {})
            econtext = envelope.get("context", {})
            arr_time = envelope.get("arrival_time", envelope.get("enqueued_at", time.time()))
            if ename == "pane.agent_status_changed":
                handle_agent_status_changed(edata, econtext, bridge_url=bridge_url, arrival_time=arr_time)
            elif ename == "pane.closed":
                handle_pane_closed(edata, econtext, bridge_url=bridge_url)
            elif ename == "tab.closed":
                handle_tab_closed(edata, econtext, bridge_url=bridge_url)
            elif ename == "workspace.closed":
                handle_workspace_closed(edata, econtext, bridge_url=bridge_url)
            elif ename == "direct_post":
                post_bartender_event(edata, bridge_url=bridge_url)
            file_path.unlink()
        except Exception as e:
            log_debug(f"Error replaying spool file {file_path}: {e}")


def reconcile_active_sessions(state_dir: Path, bridge_url: str | None = None):
    now_wall = time.time()
    cache_mgr = BoundedSessionCache(state_dir)
    targets = []
    with cache_mgr as data:
        sessions = data.get("sessions", {})
        if not sessions:
            return

        for sid, s in list(sessions.items()):
            pane_id = s.get("pane_id")

            # Check for stale session (> 24 hours for Idle/Done, > 48 hours for Waiting)
            is_stale = False
            last_ts = s.get("last_event_at", now_wall)
            if s.get("desired_state") in ("Idle", "Done") and (now_wall - last_ts > 86400):
                is_stale = True
            elif s.get("desired_state") == "Waiting" and (now_wall - last_ts > 172800):
                is_stale = True

            if is_stale:
                s["desired_state"] = "Ended"
                s["seq"] = int(s.get("seq", 0)) + 1
                s["desired_payload"] = {
                    "state": "Ended",
                    "agent": s.get("agent", "Herdr"),
                    "session_id": sid,
                    "seq": s["seq"],
                }

            if s.get("delivered_seq", 0) < s.get("seq", 0) or s.get("desired_state") == "Ended":
                if s.get("desired_state") == "Ended" and s.get("delivery_attempts", 0) >= 5:
                    s["orphaned_ended"] = True
                    continue
                if s.get("delivery_status") in ("non_retryable_failed", "retryable_exhausted"):
                    continue

                lease = s.get("lease_deadline") or 0
                sending_pid = s.get("sending_pid")
                if lease and (now_wall < lease) and is_pid_alive(sending_pid):
                    continue

                payload = s.get("desired_payload")
                if not payload:
                    payload = {
                        "state": s.get("desired_state", "Working"),
                        "agent": s.get("agent", "Herdr"),
                        "session_id": sid,
                        "seq": s.get("seq", 1),
                    }
                targets.append((sid, s.get("desired_state"), s.get("seq", 1), pane_id, payload))
        cache_mgr.save(data)

    for sid, target_state, target_seq, pane_id, payload in targets:
        success, is_non_retryable = post_bartender_event(payload, timeout=0.2, bridge_url=bridge_url)
        with cache_mgr as data:
            s = data.get("sessions", {}).get(sid)
            if not s:
                continue
            if success:
                s["delivered_state"] = target_state
                s["delivered_seq"] = target_seq
                s["delivery_attempts"] = 0
                s["delivery_status"] = "delivered"
                s.pop("delivery_error", None)
                data["last_successful_delivery"] = time.time()
                data["consecutive_failures"] = 0
                clear_delivery_down()
                clear_pane_failed(pane_id)
                for other_s in data.get("sessions", {}).values():
                    if other_s.get("delivery_status") == "retryable_exhausted":
                        other_s["delivery_attempts"] = 0
                        other_s["delivery_status"] = "in_flight"
                if target_state == "Ended" and s.get("seq") == target_seq:
                    data.get("sessions", {}).pop(sid, None)
                    remove_pane_marker(pane_id)
            elif is_non_retryable:
                s["delivery_status"] = "non_retryable_failed"
                s["rejected_seq"] = target_seq
                s["delivery_error"] = "bridge_rejected"
                touch_pane_failed(pane_id)
                if target_state == "Ended":
                    s["orphaned_ended"] = True
            else:
                s["delivery_attempts"] = s.get("delivery_attempts", 0) + 1
                s["delivery_error"] = "retryable network error"
                data["consecutive_failures"] = data.get("consecutive_failures", 0) + 1
                if data["consecutive_failures"] >= 3:
                    touch_delivery_down()
                if s.get("delivery_attempts", 0) >= 5:
                    s["delivery_status"] = "retryable_exhausted"
                    touch_pane_failed(pane_id)
                    if s.get("desired_state") == "Ended":
                        s["orphaned_ended"] = True
            cache_mgr.save(data)


def run_reconcile_background(bridge_url: str | None = None):
    if is_disabled():
        return
    state_dir = get_state_dir()
    lock_file = state_dir / "reconciler.lock"
    pending_file = state_dir / "reconciler.pending"
    lock_fd = None
    try:
        lock_fd = os.open(str(lock_file), os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        try:
            pending_file.touch(exist_ok=True)
        except Exception:
            pass
        if lock_fd is not None:
            try:
                os.close(lock_fd)
            except Exception:
                pass
        return

    try:
        while not is_disabled():
            if pending_file.exists():
                try:
                    pending_file.unlink()
                except Exception:
                    pass

            replay_spool_dir(state_dir, bridge_url=bridge_url)
            reconcile_active_sessions(state_dir, bridge_url=bridge_url)

            spool_dir = state_dir / "spool"
            has_spool = spool_dir.exists() and any(spool_dir.glob("*.json"))
            if not pending_file.exists() and not has_spool:
                break
    finally:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            os.close(lock_fd)
        except Exception:
            pass


def retry_undelivered_sessions(cache_mgr: BoundedSessionCache, bridge_url: str | None = None):
    reconcile_active_sessions(cache_mgr.state_dir, bridge_url=bridge_url)


def run_cleanup(bridge_url: str | None = None) -> bool:
    touch_heartbeat()
    state_dir = get_state_dir()
    cache_mgr = BoundedSessionCache(state_dir)
    now = time.time()
    all_cleared = True
    target_sessions = []
    with cache_mgr as data:
        sessions = data.get("sessions", {})
        for session_id, info in list(sessions.items()):
            seq = int(info.get("seq", 0)) + 1
            info["seq"] = seq
            info["desired_state"] = "Ended"
            target_sessions.append((session_id, info.get("pane_id"), info.get("agent", "Herdr"), seq))
        cache_mgr.save(data)

    for sid, pane_id, agent_name, target_seq in target_sessions:
        payload = {"state": "Ended", "agent": agent_name, "session_id": sid}
        success, is_non_retryable = post_bartender_event(payload, timeout=0.2, bridge_url=bridge_url)
        with cache_mgr as data:
            s = data.get("sessions", {}).get(sid)
            if s:
                if success or is_non_retryable:
                    if s.get("seq") == target_seq:
                        data.get("sessions", {}).pop(sid, None)
                        remove_pane_marker(pane_id)
                else:
                    all_cleared = False
                    s["delivery_attempts"] = s.get("delivery_attempts", 0) + 1
                    s["last_attempt"] = now
            cache_mgr.save(data)
    return all_cleared


def run_replay_orphans(orphan_path_str: str, bridge_url: str | None = None) -> bool:
    orphan_path = Path(orphan_path_str).expanduser()
    if not orphan_path.exists():
        print(f"[-] Orphan file not found: {orphan_path}")
        return False
    try:
        with open(orphan_path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        print(f"[-] Failed to read orphan file: {e}")
        return False

    sessions = data.get("sessions", {}) if isinstance(data, dict) else {}
    if not sessions and isinstance(data, list):
        sessions = {s.get("session_id", f"orphan_{i}"): s for i, s in enumerate(data)}
    elif not sessions and isinstance(data, dict):
        sessions = data

    print(f"[*] Replaying {len(sessions)} orphaned session(s) from {orphan_path}...")
    all_success = True
    for sid, s in list(sessions.items()):
        agent_name = s.get("agent") if isinstance(s, dict) else "Herdr"
        pane_id = s.get("pane_id") if isinstance(s, dict) else None
        payload = {
            "state": "Ended",
            "agent": agent_name or "Herdr",
            "session_id": sid,
        }
        success, is_non_retryable = post_bartender_event(payload, timeout=0.5, bridge_url=bridge_url)
        if success or is_non_retryable:
            print(f"    [+] Cleared {sid}")
            if pane_id:
                remove_pane_marker(pane_id)
        else:
            print(f"    [-] Failed to deliver Ended for {sid}")
            all_success = False

    if all_success and sessions:
        try:
            orphan_path.unlink()
            print(f"[+] Successfully cleared all orphaned sessions; removed {orphan_path}")
        except Exception:
            pass
    return all_success


def handle_agent_status_changed(event_data: dict, context: dict, bridge_url: str | None = None, arrival_time: float | None = None):
    touch_heartbeat()
    arr_time = arrival_time or PROCESS_ARRIVAL_TIME
    raw_pane = event_data.get("pane_id") or context.get("focused_pane_id")
    workspace_id = event_data.get("workspace_id") or context.get("workspace_id")
    agent_status = event_data.get("agent_status")

    if not raw_pane:
        return

    canonical_pane = normalize_pane_id(raw_pane, workspace_id)
    if not PANE_ID_REGEX.match(canonical_pane):
        log_debug(f"Invalid canonical pane ID: {canonical_pane}")
        return

    if not workspace_id:
        if ":" in canonical_pane:
            workspace_id = canonical_pane.split(":", 1)[0]
        else:
            workspace_id = None

    host = get_sanitized_hostname()
    session_id = f"herdr:{host}:{canonical_pane}"

    cache_mgr = BoundedSessionCache(get_state_dir())

    # 1. Critical section: Update cache & manage per-session monotonic lease
    with cache_mgr as data:
        sessions = data.get("sessions", {})
        raw_agent = event_data.get("agent")
        if not raw_agent and context.get("focused_pane_id") == canonical_pane:
            raw_agent = context.get("focused_pane_agent")

        # Anti-Flap Rule: Herdr may report unknown transiently during reattach/startup.
        if agent_status == "unknown":
            log_debug(f"Debouncing transient unknown status for pane {canonical_pane}")
            return

        # Qualification filter: pane must have agent metadata or already exist in cache
        existing_session = sessions.get(session_id)
        if existing_session and existing_session.get("desired_state") == "Ended":
            if not raw_agent:
                return  # Bare prompt does not resurrect an Ended session
        elif not raw_agent and session_id not in sessions:
            return

        if agent_status == "idle":
            if raw_agent is not None and str(raw_agent).strip() != "":
                mapped_state = "Idle"
            elif session_id in sessions and sessions[session_id].get("desired_state") != "Ended":
                # Agent process exited interactive shell
                mapped_state = "Ended"
            else:
                return  # Unassisted shell
        else:
            mapped_state = STATUS_MAP.get(agent_status)
            if not mapped_state:
                return

        agent_name = format_agent_name(raw_agent or sessions.get(session_id, {}).get("raw_agent"))
        raw_title = event_data.get("title") or context.get("workspace_label") or f"Pane {canonical_pane}"
        title = sanitize_title(raw_title)
        cwd = context.get("focused_pane_cwd") or context.get("workspace_cwd") or ""
        tab_id = event_data.get("tab_id") or context.get("tab_id")

        now_wall = time.time()
        source_ts = event_data.get("timestamp")
        last_source_ts = sessions.get(session_id, {}).get("last_source_timestamp", 0)
        if source_ts and last_source_ts and source_ts < last_source_ts:
            return

        session_record = sessions.setdefault(session_id, {})
        last_applied_arr = session_record.get("last_applied_arrival_time", 0.0)
        if mapped_state != "Ended" and arr_time < last_applied_arr:
            log_debug(f"Dropping older event: arrival {arr_time} < last_applied {last_applied_arr}")
            return

        new_seq = int(session_record.get("seq", 0)) + 1
        touch_pane_marker(canonical_pane)

        payload = {
            "state": mapped_state,
            "agent": agent_name,
            "session_id": session_id,
            "title": title,
            "cwd": cwd,
            "terminal": "Herdr",
            "event": "pane.agent_status_changed",
            "seq": new_seq,
        }

        session_record.update({
            "pane_id": canonical_pane,
            "workspace_id": workspace_id,
            "tab_id": tab_id,
            "host": host,
            "agent": agent_name,
            "raw_agent": raw_agent,
            "title": title,
            "cwd": cwd,
            "desired_state": mapped_state,
            "desired_payload": payload,
            "seq": new_seq,
            "delivery_status": "in_flight",
            "delivery_error": None,
            "delivery_attempts": 0,
            "last_applied_arrival_time": arr_time,
            "last_event_at": now_wall,
        })
        if source_ts:
            session_record["last_source_timestamp"] = source_ts

        active_lease = session_record.get("lease_deadline") or 0
        sending_pid = session_record.get("sending_pid")
        if active_lease and (active_lease > now_wall + 5.0):
            active_lease = 0

        if active_lease and (now_wall < active_lease) and is_pid_alive(sending_pid):
            cache_mgr.save(data)
            return

        # Claim sending lease with unique lease token
        my_token = f"{os.getpid()}:{now_wall}"
        session_record["lease_token"] = my_token
        session_record["sending_pid"] = os.getpid()
        session_record["lease_deadline"] = now_wall + 2.0
        cache_mgr.save(data)
        current_payload = payload
        transmitting_state = mapped_state
        transmitting_seq = new_seq

    # 2. Outside lock: transmit and drain queue with lease ownership verification
    while current_payload:
        success, is_non_retryable = post_bartender_event(current_payload, bridge_url=bridge_url)
        with cache_mgr as data:
            s = data.get("sessions", {}).get(session_id)
            if not s:
                break
            if s.get("lease_token") != my_token:
                log_debug(f"Lease token superseded for {session_id}, exiting drain loop")
                break

            if success:
                s["delivered_state"] = transmitting_state
                s["delivered_seq"] = transmitting_seq
                s["delivery_status"] = "delivered"
                s["delivery_attempts"] = 0
                s.pop("delivery_error", None)
                data["last_successful_delivery"] = time.time()
                data["consecutive_failures"] = 0
                clear_delivery_down()
                clear_pane_failed(canonical_pane)
                for other_s in data.get("sessions", {}).values():
                    if other_s.get("delivery_status") == "retryable_exhausted":
                        other_s["delivery_attempts"] = 0
                        other_s["delivery_status"] = "in_flight"

                # Active Supersession check on Ended
                if transmitting_state == "Ended" and s.get("seq") == transmitting_seq:
                    data.get("sessions", {}).pop(session_id, None)
                    remove_pane_marker(canonical_pane)
                    cache_mgr.save(data)
                    break
            elif is_non_retryable:
                s["delivery_status"] = "non_retryable_failed"
                s["rejected_seq"] = transmitting_seq
                s["delivery_error"] = "bridge_rejected"
                touch_pane_failed(canonical_pane)
                if transmitting_state == "Ended":
                    s["orphaned_ended"] = True
            else:
                s["delivery_attempts"] = s.get("delivery_attempts", 0) + 1
                s["delivery_error"] = "retryable network error"
                data["consecutive_failures"] = data.get("consecutive_failures", 0) + 1
                if data["consecutive_failures"] >= 3:
                    touch_delivery_down()
                if s.get("delivery_attempts", 0) >= 5:
                    s["delivery_status"] = "retryable_exhausted"
                    touch_pane_failed(canonical_pane)
                    if s.get("desired_state") == "Ended":
                        s["orphaned_ended"] = True

            # Drain check: if a newer state was requested while in-flight, loop and transmit it
            if s.get("delivered_seq", 0) < s.get("seq", 0) and time_remaining() > 0.3 and s.get("delivery_status") not in ("non_retryable_failed", "retryable_exhausted"):
                s["lease_deadline"] = time.time() + 2.0
                current_payload = s.get("desired_payload")
                transmitting_state = s.get("desired_state")
                transmitting_seq = s.get("seq")
                cache_mgr.save(data)
            else:
                s["sending_pid"] = None
                s["lease_token"] = None
                s["lease_deadline"] = None
                if s.get("delivered_seq", 0) < s.get("seq", 0) and s.get("delivery_status") != "non_retryable_failed":
                    # Process ran out of deadline budget; hand off to background helper
                    try:
                        subprocess.Popen(
                            [sys.executable, str(Path(__file__).resolve()), "--reconcile-background"],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            start_new_session=True,
                        )
                    except Exception:
                        pass
                cache_mgr.save(data)
                current_payload = None


def handle_pane_closed(event_data: dict, context: dict, bridge_url: str | None = None):
    touch_heartbeat()
    raw_pane = event_data.get("pane_id") or context.get("focused_pane_id")
    workspace_id = event_data.get("workspace_id") or context.get("workspace_id")
    if not raw_pane:
        return

    canonical_pane = normalize_pane_id(raw_pane, workspace_id)
    if not PANE_ID_REGEX.match(canonical_pane):
        log_debug(f"Invalid canonical pane ID: {canonical_pane}")
        return
    cache_mgr = BoundedSessionCache(get_state_dir())
    target_sessions = []

    with cache_mgr as data:
        sessions = data.get("sessions", {})
        for sid, info in list(sessions.items()):
            if info.get("pane_id") == canonical_pane or sid.endswith(f":{canonical_pane}"):
                seq = int(info.get("seq", 0)) + 1
                info["desired_state"] = "Ended"
                info["seq"] = seq
                target_sessions.append((sid, info.get("agent", "Herdr"), seq))
        if target_sessions:
            cache_mgr.save(data)

    # Dispatch Ended outside lock
    for sid, agent_name, target_seq in target_sessions:
        success, is_non_retryable = post_bartender_event(
            {"state": "Ended", "agent": agent_name, "session_id": sid},
            bridge_url=bridge_url
        )
        if success or is_non_retryable:
            with cache_mgr as data:
                s = data.get("sessions", {}).get(sid)
                if s and s.get("desired_state") == "Ended" and s.get("seq") == target_seq:
                    data.get("sessions", {}).pop(sid, None)
                    remove_pane_marker(canonical_pane)
                    cache_mgr.save(data)


def handle_tab_closed(event_data: dict, context: dict, bridge_url: str | None = None):
    touch_heartbeat()
    tab_id = event_data.get("tab_id") or context.get("tab_id")
    if not tab_id:
        return
    if not CONTAINER_ID_REGEX.match(str(tab_id)):
        log_debug(f"Invalid tab_id: {tab_id}")
        return

    cache_mgr = BoundedSessionCache(get_state_dir())
    target_sessions = []

    with cache_mgr as data:
        sessions = data.get("sessions", {})
        for sid, info in list(sessions.items()):
            s_tab = info.get("tab_id")
            if s_tab and (s_tab == tab_id or tab_id.endswith(str(s_tab))):
                seq = int(info.get("seq", 0)) + 1
                info["desired_state"] = "Ended"
                info["seq"] = seq
                target_sessions.append((sid, info.get("pane_id"), info.get("agent", "Herdr"), seq))
        if target_sessions:
            cache_mgr.save(data)

    for sid, pane_id, agent_name, target_seq in target_sessions:
        success, is_non_retryable = post_bartender_event(
            {"state": "Ended", "agent": agent_name, "session_id": sid},
            bridge_url=bridge_url
        )
        if success or is_non_retryable:
            with cache_mgr as data:
                s = data.get("sessions", {}).get(sid)
                if s and s.get("desired_state") == "Ended" and s.get("seq") == target_seq:
                    data.get("sessions", {}).pop(sid, None)
                    remove_pane_marker(pane_id)
                    cache_mgr.save(data)


def handle_workspace_closed(event_data: dict, context: dict, bridge_url: str | None = None):
    touch_heartbeat()
    workspace_id = event_data.get("workspace_id") or context.get("workspace_id")
    if not workspace_id:
        return
    if not CONTAINER_ID_REGEX.match(str(workspace_id)):
        log_debug(f"Invalid workspace_id: {workspace_id}")
        return

    cache_mgr = BoundedSessionCache(get_state_dir())
    target_sessions = []

    with cache_mgr as data:
        sessions = data.get("sessions", {})
        for sid, info in list(sessions.items()):
            s_ws = info.get("workspace_id")
            if s_ws and (s_ws == workspace_id or f":{workspace_id}:" in sid):
                seq = int(info.get("seq", 0)) + 1
                info["desired_state"] = "Ended"
                info["seq"] = seq
                target_sessions.append((sid, info.get("pane_id"), info.get("agent", "Herdr"), seq))
        if target_sessions:
            cache_mgr.save(data)

    for sid, pane_id, agent_name, target_seq in target_sessions:
        success, is_non_retryable = post_bartender_event(
            {"state": "Ended", "agent": agent_name, "session_id": sid},
            bridge_url=bridge_url
        )
        if success or is_non_retryable:
            with cache_mgr as data:
                s = data.get("sessions", {}).get(sid)
                if s and s.get("desired_state") == "Ended" and s.get("seq") == target_seq:
                    data.get("sessions", {}).pop(sid, None)
                    remove_pane_marker(pane_id)
                    cache_mgr.save(data)


# ==============================================================================
# Testing & Verification Harness
# ==============================================================================

class MockBartenderHandler(BaseHTTPRequestHandler):
    sessions = {}
    history = []
    delay = 0.0
    return_code = 200

    def log_message(self, format, *args):
        pass

    def do_GET(self):
        if self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"ok": True, "port": self.server.server_port, "sessions": len(self.sessions)}).encode())
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        if self.delay > 0:
            time.sleep(self.delay)

        if self.return_code != 200:
            self.send_response(self.return_code)
            self.end_headers()
            return

        if self.path == "/event":
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length).decode("utf-8")
            data = json.loads(body)
            MockBartenderHandler.history.append(data)
            sid = data.get("session_id")
            state = data.get("state")
            if state == "Ended":
                MockBartenderHandler.sessions.pop(sid, None)
            else:
                MockBartenderHandler.sessions[sid] = data
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"ok":true}')
        else:
            self.send_response(404)
            self.end_headers()


def run_unit_tests():
    print("=== Running Comprehensive Hardened Unit Test Suite ===")
    global PROCESS_DEADLINE_SECONDS, START_TIME
    PROCESS_DEADLINE_SECONDS = 60.0
    START_TIME = time.monotonic()
    MockBartenderHandler.sessions = {}
    MockBartenderHandler.history = []
    MockBartenderHandler.delay = 0.0
    MockBartenderHandler.return_code = 200

    server = ThreadingHTTPServer(("127.0.0.1", 0), MockBartenderHandler)
    mock_port = server.server_port
    server_thread = threading.Thread(target=server.serve_forever, daemon=True)
    server_thread.start()

    mock_url = f"http://127.0.0.1:{mock_port}"
    os.environ["NOTCHBAR_AGENTS_HOST"] = "127.0.0.1"
    os.environ["NOTCHBAR_AGENTS_PORT"] = str(mock_port)

    # 1. Bridge health check
    health = check_bridge_health(bridge_url=mock_url)
    assert health and health["ok"] is True, "Health check failed"
    print("[PASS] Mock bridge health check")

    # 2. Lifecycle transitions
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "w1:p1", "workspace_id": "w1", "agent": "claude", "title": "Unit test turn"},
        {"tab_id": "w1:t1"},
        bridge_url=mock_url
    )
    assert len(MockBartenderHandler.sessions) == 1
    assert list(MockBartenderHandler.sessions.values())[0]["state"] == "Working"
    print("[PASS] Working status transition")

    handle_agent_status_changed(
        {"agent_status": "blocked", "pane_id": "w1:p1", "workspace_id": "w1", "agent": "claude"},
        {"tab_id": "w1:t1"},
        bridge_url=mock_url
    )
    assert list(MockBartenderHandler.sessions.values())[0]["state"] == "Waiting"
    print("[PASS] Blocked -> Waiting attention transition")

    # Anti-Flap: unknown status does NOT evict active session
    handle_agent_status_changed(
        {"agent_status": "unknown", "pane_id": "w1:p1", "workspace_id": "w1"},
        {"tab_id": "w1:t1"},
        bridge_url=mock_url
    )
    assert len(MockBartenderHandler.sessions) == 1
    print("[PASS] Unknown status debounced (anti-flap)")

    # 3. Cascading container closures
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "wTest:pA", "workspace_id": "wTest", "agent": "codex"},
        {"tab_id": "wTest:tA"},
        bridge_url=mock_url
    )
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "wTest:pB", "workspace_id": "wTest", "agent": "claude"},
        {"tab_id": "wTest:tB"},
        bridge_url=mock_url
    )
    assert len(MockBartenderHandler.sessions) == 3

    handle_tab_closed({"tab_id": "wTest:tA"}, {}, bridge_url=mock_url)
    assert len(MockBartenderHandler.sessions) == 2

    handle_workspace_closed({"workspace_id": "wTest"}, {}, bridge_url=mock_url)
    assert len(MockBartenderHandler.sessions) == 1

    handle_pane_closed({"pane_id": "w1:p1", "workspace_id": "w1"}, {}, bridge_url=mock_url)
    assert len(MockBartenderHandler.sessions) == 0
    print("[PASS] Container cascades (pane, tab & workspace)")

    # 4. Out-of-order source timestamp sequencing
    t_base = time.time()
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "w1:pSeq", "workspace_id": "w1", "agent": "claude", "timestamp": t_base + 10},
        {},
        bridge_url=mock_url
    )
    # Stale event with older timestamp should be rejected
    handle_agent_status_changed(
        {"agent_status": "idle", "pane_id": "w1:pSeq", "workspace_id": "w1", "agent": "claude", "timestamp": t_base + 2},
        {},
        bridge_url=mock_url
    )
    cache_mgr = BoundedSessionCache(get_state_dir())
    with cache_mgr as data:
        sid = f"herdr:{get_sanitized_hostname()}:w1:pSeq"
        assert data["sessions"][sid]["desired_state"] == "Working", "Stale event must not overwrite state"
        assert data["sessions"][sid]["seq"] >= 1, "Integer seq must be incremented"
    print("[PASS] Out-of-order source timestamp suppression")

    # 5. Failed Ended & Active Supersession
    MockBartenderHandler.return_code = 500
    handle_pane_closed({"pane_id": "w1:pSeq", "workspace_id": "w1"}, {}, bridge_url=mock_url)
    with cache_mgr as data:
        assert data["sessions"][sid]["desired_state"] == "Ended", "Failed Ended must mark desired_state=Ended"
    print("[PASS] Failed Ended recorded in unified cache")

    # A new turn arrives for the same pane -> Active Supersession
    MockBartenderHandler.return_code = 200
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "w1:pSeq", "workspace_id": "w1", "agent": "claude", "seq": t_base + 20},
        {},
        bridge_url=mock_url
    )
    with cache_mgr as data:
        assert data["sessions"][sid]["desired_state"] == "Working", "Active event must supersede Ended"
    print("[PASS] Active event supersedes and cancels pending Ended")

    # 6. HTTP 4xx drops session immediately (non-retryable)
    MockBartenderHandler.return_code = 400
    handle_pane_closed({"pane_id": "w1:pSeq", "workspace_id": "w1"}, {}, bridge_url=mock_url)
    with cache_mgr as data:
        assert sid not in data["sessions"], "HTTP 4xx must evict Ended session immediately"
    print("[PASS] HTTP 4xx non-retryable eviction")

    # 7. Corrupt cache quarantine with session ID salvage
    MockBartenderHandler.return_code = 200
    cache_file = get_state_dir() / "active-sessions.json"
    with open(cache_file, "w") as f:
        f.write('{"sessions": {"herdr:macbook:w1:pSalvage": {"state": "Working"}}, invalid json...')
    with cache_mgr as data:
        assert "herdr:macbook:w1:pSalvage" in data.get("sessions", {}), "Expected candidate ID to be salvaged"
    corrupt_files = list(get_state_dir().glob("active-sessions.json.corrupt.*"))
    assert len(corrupt_files) > 0, "Expected corrupt cache to be quarantined"
    print("[PASS] Corrupt cache quarantine and session salvage under lock")

    # 8. Process deadline enforcement under slow network
    MockBartenderHandler.delay = 3.0
    t0 = time.monotonic()
    post_bartender_event({"state": "Working", "agent": "Test", "session_id": "timeout-test"}, timeout=0.5, bridge_url=mock_url)
    elapsed = time.monotonic() - t0
    assert elapsed < 1.0, f"Expected bounded exit, took {elapsed}s"
    print(f"[PASS] Bounded request timeout enforcement ({elapsed:.2f}s < 1.0s)")

    MockBartenderHandler.delay = 0.0

    # 9. Atomic spool directory enqueue, arrival ordering and ingestion
    spool_dir = get_state_dir() / "spool"
    if spool_dir.exists():
        for f in spool_dir.glob("*.json*"):
            f.unlink()
    enqueue_spool("direct_post", {"state": "Working", "agent": "SpoolAgent", "session_id": "spool-session-1"}, {})
    enqueue_spool("direct_post", {"state": "Done", "agent": "SpoolAgent", "session_id": "spool-session-1"}, {})
    spool_files = list(spool_dir.glob("*.json"))
    assert len(spool_files) == 2, f"Expected 2 spooled files, got {len(spool_files)}"
    replay_spool_dir(get_state_dir(), bridge_url=mock_url)
    assert len(list(spool_dir.glob("*.json"))) == 0, "All spool files should be ingested and unlinked"
    spool_events = [e for e in MockBartenderHandler.history if e.get("session_id") == "spool-session-1"]
    assert len(spool_events) == 2, f"Expected 2 spooled events delivered, got {len(spool_events)}"

    # Test arrival ordering: older spooled event should be dropped
    t_arr = time.time()
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "w1:pArrival", "workspace_id": "w1", "agent": "claude"},
        {},
        bridge_url=mock_url,
        arrival_time=t_arr
    )
    # Enqueue spooled event with older arrival time
    enqueue_spool(
        "pane.agent_status_changed",
        {"agent_status": "idle", "pane_id": "w1:pArrival", "workspace_id": "w1", "agent": "claude"},
        {},
        arrival_time=t_arr - 5.0
    )
    replay_spool_dir(get_state_dir(), bridge_url=mock_url)
    with cache_mgr as data:
        s_arr = data["sessions"].get(f"herdr:{get_sanitized_hostname()}:w1:pArrival")
        assert s_arr and s_arr["desired_state"] == "Working", "Older spooled event must not overwrite newer state"
    print("[PASS] Atomic spool directory enqueue, ingestion, and arrival ordering")

    # 10. Reconciler singleton with pending work re-scan
    lock_file = get_state_dir() / "reconciler.lock"
    pending_file = get_state_dir() / "reconciler.pending"
    test_fd = os.open(str(lock_file), os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(test_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    run_reconcile_background(bridge_url=mock_url)
    assert pending_file.exists(), "Reconciler should touch reconciler.pending when lock is held"
    fcntl.flock(test_fd, fcntl.LOCK_UN)
    os.close(test_fd)
    run_reconcile_background(bridge_url=mock_url)
    assert not pending_file.exists(), "Reconciler should consume and unlink reconciler.pending"
    print("[PASS] Background reconciler singleton and pending-work re-scan loop")

    # 11. Injective hex-encoded pane marker lifecycle & freshness
    test_pane = "w1:test/dangerous:pane..id"
    hex_id = get_hex_pane_id(test_pane)
    assert "/" not in hex_id and ".." not in hex_id and ":" not in hex_id, f"Unsafe chars in {hex_id}"
    touch_pane_marker(test_pane)
    marker_path = get_state_dir() / "panes" / hex_id
    assert marker_path.exists(), f"Expected marker at {marker_path}"
    mtime_str = marker_path.read_text().strip()
    assert int(mtime_str) > 0, "Marker should store unix timestamp"
    remove_pane_marker(test_pane)
    assert not marker_path.exists(), f"Marker should be removed from {marker_path}"
    print("[PASS] Injective hex-encoded pane marker lifecycle and freshness timestamp")

    # 12. Tombstone DISABLED flag
    disabled_path = get_state_dir() / "DISABLED"
    disabled_path.touch()
    assert is_disabled() is True, "DISABLED flag should be recognized"
    disabled_path.unlink()
    assert is_disabled() is False, "DISABLED flag removal should be recognized"
    print("[PASS] Tombstone DISABLED flag enforcement")

    # 13. Waiting sessions exempt from 24h TTL eviction
    with cache_mgr as data:
        data["sessions"]["herdr:macbook:wWait"] = {
            "desired_state": "Waiting",
            "seq": 1,
            "delivered_seq": 1,
            "last_event_at": time.time() - 90000,
            "pane_id": "w1:pWait",
            "agent": "Claude (Herdr)",
        }
        data["sessions"]["herdr:macbook:wIdle"] = {
            "desired_state": "Idle",
            "seq": 1,
            "delivered_seq": 1,
            "last_event_at": time.time() - 90000,
            "pane_id": "w1:pIdle",
            "agent": "Claude (Herdr)",
        }
        cache_mgr.save(data)
    touch_pane_marker("w1:pWait")
    touch_pane_marker("w1:pIdle")
    reconcile_active_sessions(get_state_dir(), bridge_url=mock_url)
    with cache_mgr as data:
        assert "herdr:macbook:wWait" in data["sessions"], "Waiting session must remain in cache"
        assert data["sessions"]["herdr:macbook:wWait"]["desired_state"] == "Waiting", "Waiting sessions must be exempt from TTL"
        assert "herdr:macbook:wIdle" not in data["sessions"], "Idle sessions must transition to Ended and be evicted on confirmed delivery"
    print("[PASS] Waiting session exemption from 24h TTL eviction")

    # 14. Waiting session expires after 48h TTL
    with cache_mgr as data:
        data["sessions"]["herdr:macbook:wWaitOld"] = {
            "desired_state": "Waiting",
            "seq": 1,
            "delivered_seq": 1,
            "last_event_at": time.time() - 200000,
            "pane_id": "w1:pWaitOld",
            "agent": "Claude (Herdr)",
        }
        cache_mgr.save(data)
    touch_pane_marker("w1:pWaitOld")
    reconcile_active_sessions(get_state_dir(), bridge_url=mock_url)
    with cache_mgr as data:
        assert "herdr:macbook:wWaitOld" not in data["sessions"], "Waiting sessions older than 48h must expire to Ended"
    print("[PASS] Bounded Waiting session 48h TTL expiration")

    # 15. Orphan Replay (--replay-orphans)
    orphan_file = get_state_dir() / "test-orphans.json"
    orphan_data = {
        "sessions": {
            "herdr:macbook:wOrphan": {
                "agent": "Claude (Herdr)",
                "pane_id": "w1:pOrphan",
            }
        }
    }
    with open(orphan_file, "w") as f:
        json.dump(orphan_data, f)
    touch_pane_marker("w1:pOrphan")
    ok = run_replay_orphans(str(orphan_file), bridge_url=mock_url)
    assert ok is True, "Orphan replay should succeed"
    assert not orphan_file.exists(), "Orphan file should be removed after successful replay"
    print("[PASS] Orphan replay clears sessions and cleans up file")

    # 16. Spooled close events exempt from arrival drops
    t_close_arr = time.time()
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "w1:pCloseTest", "workspace_id": "w1", "agent": "claude"},
        {},
        bridge_url=mock_url,
        arrival_time=t_close_arr
    )
    # Enqueue a pane.closed event with an older arrival timestamp
    enqueue_spool(
        "pane.closed",
        {"pane_id": "w1:pCloseTest", "workspace_id": "w1"},
        {},
        arrival_time=t_close_arr - 10.0
    )
    replay_spool_dir(get_state_dir(), bridge_url=mock_url)
    with cache_mgr as data:
        s_closed = data["sessions"].get(f"herdr:{get_sanitized_hostname()}:w1:pCloseTest")
        assert s_closed is None or s_closed.get("desired_state") == "Ended", "Close event must never be dropped by arrival time"
    print("[PASS] Spooled close events exempt from arrival ordering drops")

    # 17. Delivery down marker & pane failure tracking
    touch_delivery_down()
    assert is_delivery_down() is True, "DELIVERY_DOWN marker must be recognized"
    touch_pane_failed("w1:pFail")
    failed_marker = get_state_dir() / "panes" / f"{get_hex_pane_id('w1:pFail')}.failed"
    assert failed_marker.exists(), "Pane failed marker must exist"
    clear_delivery_down()
    assert is_delivery_down() is False, "DELIVERY_DOWN marker must be cleared"
    clear_pane_failed("w1:pFail")
    assert not failed_marker.exists(), "Pane failed marker must be cleared"
    print("[PASS] Delivery down & pane failure marker lifecycle")

    server.shutdown()
    print("=== ALL COMPREHENSIVE UNIT TESTS PASSED ===")


def run_live_test():
    print(f"Checking Bartender bridge at {get_bridge_url()}...")
    health = check_bridge_health()
    if not health:
        print("[-] Error: Bartender bridge not reachable. Make sure Bartender 6 is running with Top Shelf enabled.")
        sys.exit(1)
    print(f"[+] Bartender bridge is healthy: {health}")

    host = get_sanitized_hostname()
    test_session = f"herdr:{host}:test_workspace:test_pane_1"
    print("\n1. Emitting 'Working' state...")
    post_bartender_event({
        "state": "Working",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
        "title": "Unit test running in Herdr",
        "terminal": "Herdr",
    })
    print("   Sent Working. Top Shelf should show active spinner.")

    time.sleep(1.0)

    print("\n2. Emitting 'Waiting' state (Awaiting input / attention)...")
    post_bartender_event({
        "state": "Waiting",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
        "title": "Awaiting user confirmation in Herdr",
        "terminal": "Herdr",
    })
    print("   Sent Waiting. Top Shelf NotchBar should highlight attention banner.")

    time.sleep(1.0)

    print("\n3. Emitting 'Done' state...")
    post_bartender_event({
        "state": "Done",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
        "title": "Task completed successfully",
        "terminal": "Herdr",
    })
    print("   Sent Done. Top Shelf should show completion.")

    time.sleep(1.0)

    print("\n4. Emitting 'Ended' state (Pane closed)...")
    post_bartender_event({
        "state": "Ended",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
    })
    print("   Sent Ended. Session removed from Top Shelf.")

    final_health = check_bridge_health()
    print(f"\n[+] Live test complete! Final bridge health: {final_health}")


def main():
    args = sys.argv[1:]

    if "--unit-test" in args:
        run_unit_tests()
        return

    if "--test" in args:
        run_live_test()
        return

    if "--health" in args:
        h = check_bridge_health()
        result = h or {"error": "unreachable"}
        hooks_ok, missing = verify_vendor_hooks_intact()
        result["hooks_guard_intact"] = hooks_ok
        if missing:
            result["hooks_guard_missing"] = missing
        print(json.dumps(result, indent=2))
        return

    if "--install-hooks" in args:
        ok = install_hooks()
        sys.exit(0 if ok else 1)

    if "--cleanup" in args:
        ok = run_cleanup()
        sys.exit(0 if ok else 1)

    if "--replay-orphans" in args:
        idx = args.index("--replay-orphans")
        if idx + 1 < len(args):
            orphan_file = args[idx + 1]
            ok = run_replay_orphans(orphan_file)
            sys.exit(0 if ok else 1)
        else:
            print("Usage: --replay-orphans <path-to-orphan-file>")
            sys.exit(1)

    if "--sessions" in args:
        cache_mgr = BoundedSessionCache(get_state_dir())
        with cache_mgr as data:
            print(json.dumps(data, indent=2))
        return

    if "--reconcile-background" in args:
        run_reconcile_background()
        return

    if is_disabled():
        sys.exit(0)

    # Normal Herdr event dispatch
    arm_watchdog()
    touch_heartbeat()
    event_name = os.environ.get("HERDR_PLUGIN_EVENT", "")
    event_json_raw = os.environ.get("HERDR_PLUGIN_EVENT_JSON", "{}")
    context_json_raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON", "{}")

    try:
        envelope = json.loads(event_json_raw)
    except Exception:
        envelope = {}

    try:
        context = json.loads(context_json_raw)
    except Exception:
        context = {}

    data = envelope.get("data", {})

    if event_name == "pane.agent_status_changed":
        handle_agent_status_changed(data, context)
    elif event_name == "pane.closed":
        handle_pane_closed(data, context)
    elif event_name == "tab.closed":
        handle_tab_closed(data, context)
    elif event_name == "workspace.closed":
        handle_workspace_closed(data, context)


if __name__ == "__main__":
    main()
