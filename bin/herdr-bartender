#!/usr/bin/env python3
"""
herdr-bartender: Herdr plugin to synchronize agent status and pane notifications
into Bartender Pro's Top Shelf (NotchBar) HTTP bridge.
"""

import sys
import os
import json
import socket
import re
import fcntl
import time
import signal
import urllib.request
import urllib.error
from pathlib import Path
from http.server import HTTPServer, BaseHTTPRequestHandler
import threading

DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 7823
PROCESS_DEADLINE_SECONDS = 1.4

AGENT_NAME_OVERRIDES = {
    "claude": "Claude",
    "codex": "Codex",
    "kilo": "Kilo",
    "grok": "Grok",
    "cursor": "Cursor",
    "copilot": "Copilot",
    "kimi": "Kimi",
    "opencode": "OpenCode",
}

STATUS_MAP = {
    "blocked": "Waiting",   # Awaiting user input / permission -> NotchBar highlight
    "working": "Working",   # Turn or tool running
    "done": "Done",         # Completed
    "idle": "Idle",         # Idle at prompt
}

ANSI_REGEX = re.compile(r'\x1b\[[0-9;]*[a-zA-Z]')
START_TIME = time.monotonic()
IN_CRITICAL_SECTION = False
PENDING_WATCHDOG_EXIT = False


def _timeout_watchdog(signum, frame):
    global PENDING_WATCHDOG_EXIT
    if IN_CRITICAL_SECTION:
        PENDING_WATCHDOG_EXIT = True
        return
    log_debug("Watchdog deadline exceeded (SIGALRM)")
    sys.exit(0)


def arm_watchdog():
    if hasattr(signal, "SIGALRM"):
        try:
            signal.signal(signal.SIGALRM, _timeout_watchdog)
            if hasattr(signal, "setitimer"):
                signal.setitimer(signal.ITIMER_REAL, PROCESS_DEADLINE_SECONDS)
            else:
                signal.alarm(int(PROCESS_DEADLINE_SECONDS) + 1)
        except Exception:
            pass


def is_pid_alive(pid: int | None) -> bool:
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def time_remaining() -> float:
    elapsed = time.monotonic() - START_TIME
    rem = PROCESS_DEADLINE_SECONDS - elapsed
    return max(0.1, rem)


def get_sanitized_hostname() -> str:
    raw = socket.gethostname().split('.')[0].lower()
    clean = re.sub(r'[^a-z0-9_-]', '', raw)
    return clean or "local"


def get_bridge_url() -> str:
    host = os.environ.get("NOTCHBAR_AGENTS_HOST") or DEFAULT_HOST
    port = os.environ.get("NOTCHBAR_AGENTS_PORT") or str(DEFAULT_PORT)
    # Restrict to loopback unless explicitly overridden
    if host not in ("127.0.0.1", "localhost") and os.environ.get("HERDR_ALLOW_REMOTE_NOTCHBAR") != "1":
        log_debug(f"Warning: Non-loopback host {host} specified without HERDR_ALLOW_REMOTE_NOTCHBAR=1. Falling back to 127.0.0.1")
        host = DEFAULT_HOST
    return f"http://{host}:{port}"


def get_state_dir() -> Path:
    state_env = os.environ.get("HERDR_PLUGIN_STATE_DIR")
    if state_env:
        p = Path(state_env)
    else:
        xdg_state = os.environ.get("XDG_STATE_HOME")
        if xdg_state:
            p = Path(xdg_state) / "herdr" / "plugins" / "herdr-bartender"
        else:
            p = Path.home() / ".local" / "state" / "herdr" / "plugins" / "herdr-bartender"
    p.mkdir(parents=True, exist_ok=True)
    return p


def touch_heartbeat():
    try:
        marker = get_state_dir() / "plugin-active"
        marker.touch(exist_ok=True)
    except Exception:
        pass


def log_debug(msg: str):
    try:
        log_file = get_state_dir() / "plugin.log"
        with open(log_file, "a", encoding="utf-8") as f:
            f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")
    except Exception:
        pass


def post_bartender_event(payload: dict, timeout: float = 0.6, bridge_url: str | None = None) -> tuple[bool, bool]:
    """Posts event to Bartender Pro bridge. Returns (success: bool, is_4xx: bool)."""
    eff_timeout = min(timeout, time_remaining())
    url = f"{bridge_url or get_bridge_url()}/event"
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=eff_timeout) as resp:
            if resp.status == 200:
                res_body = json.loads(resp.read().decode("utf-8", errors="ignore"))
                return (res_body.get("ok") is True, False)
            is_4xx = 400 <= resp.status < 500
            return (False, is_4xx)
    except urllib.error.HTTPError as e:
        log_debug(f"HTTPError {e.code} posting to {url}: {e}")
        is_4xx = 400 <= e.code < 500
        return (False, is_4xx)
    except Exception as e:
        log_debug(f"Failed to post event to {url}: {e}")
        return (False, False)


def check_bridge_health(timeout: float = 0.6, bridge_url: str | None = None) -> dict | None:
    eff_timeout = min(timeout, time_remaining())
    url = f"{bridge_url or get_bridge_url()}/health"
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=eff_timeout) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8", errors="ignore"))
    except Exception as e:
        log_debug(f"Health check failed for {url}: {e}")
    return None


class BoundedSessionCache:
    """Thread/Process-safe session cache with non-blocking bounded locking and quarantine."""

    def __init__(self, state_dir: Path):
        self.state_dir = state_dir
        self.cache_file = state_dir / "active-sessions.json"
        self.lock_file = state_dir / "active-sessions.lock"
        self._lock_fd = None

    def __enter__(self):
        self._lock_fd = os.open(str(self.lock_file), os.O_CREAT | os.O_RDWR, 0o600)
        # Bounded acquisition with backoff up to 200ms
        deadline = time.monotonic() + 0.2
        acquired = False
        while time.monotonic() < deadline:
            try:
                fcntl.flock(self._lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                acquired = True
                break
            except (IOError, OSError):
                time.sleep(0.01)
        if not acquired:
            log_debug("Warning: lock contention exceeded 200ms, proceeding with best effort")
        return self._load()

    def __exit__(self, exc_type, exc_val, exc_tb):
        try:
            if self._lock_fd is not None:
                fcntl.flock(self._lock_fd, fcntl.LOCK_UN)
                os.close(self._lock_fd)
        except Exception:
            pass

    def _load(self) -> dict:
        if not self.cache_file.exists():
            return {
                "version": 1,
                "host": get_sanitized_hostname(),
                "sessions": {},
                "last_successful_delivery": 0.0,
                "consecutive_failures": 0,
            }
        try:
            with open(self.cache_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                if not isinstance(data, dict) or "sessions" not in data:
                    raise ValueError("Malformed cache structure")
                return data
        except Exception as e:
            log_debug(f"Quarantining corrupt cache: {e}")
            salvaged = {}
            try:
                # Best-effort salvage of candidate session IDs from corrupt raw text
                try:
                    with open(self.cache_file, "r", encoding="utf-8", errors="ignore") as cf:
                        raw_text = cf.read()
                        matches = re.findall(r'herdr:[a-zA-Z0-9_-]+:[a-zA-Z0-9_:-]+', raw_text)
                        for m in set(matches):
                            salvaged[m] = {"desired_state": "Ended", "agent": "Herdr"}
                except Exception:
                    pass
                corrupt_path = self.state_dir / f"active-sessions.json.corrupt.{int(time.time())}"
                self.cache_file.replace(corrupt_path)
            except Exception:
                pass
            return {
                "version": 1,
                "host": get_sanitized_hostname(),
                "sessions": salvaged,
                "last_successful_delivery": 0.0,
                "consecutive_failures": 0,
            }

    def save(self, data: dict):
        global IN_CRITICAL_SECTION
        IN_CRITICAL_SECTION = True
        try:
            data["last_updated"] = time.time()
            data["host"] = get_sanitized_hostname()
            tmp_path = self.state_dir / f"active-sessions.json.tmp.{os.getpid()}"
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp_path, self.cache_file)
        except Exception as e:
            log_debug(f"Error saving cache: {e}")
        finally:
            IN_CRITICAL_SECTION = False
            if PENDING_WATCHDOG_EXIT:
                log_debug("Exiting cleanly after deferred watchdog deadline")
                sys.exit(0)


def sanitize_title(raw: str | None) -> str:
    if not raw:
        return ""
    stripped = ANSI_REGEX.sub('', str(raw)).strip()
    return stripped[:120]


def format_agent_name(raw_agent: str | None) -> str:
    if not raw_agent or not raw_agent.strip():
        return "Herdr"
    clean = raw_agent.strip().lower()
    pretty = AGENT_NAME_OVERRIDES.get(clean, clean.capitalize())
    return f"{pretty} (Herdr)"


def normalize_pane_id(raw_pane_id: str, workspace_id: str | None) -> str:
    if ":" in raw_pane_id:
        return raw_pane_id
    ws = workspace_id or "w1"
    return f"{ws}:{raw_pane_id}"


def retry_undelivered_sessions(cache_mgr: BoundedSessionCache, bridge_url: str | None = None):
    """Re-sends undelivered non-ended state for sessions where delivered_state != desired_state."""
    now_wall = time.time()
    with cache_mgr as data:
        sessions = data.get("sessions", {})
        if not sessions:
            return
        for sid, s in list(sessions.items()):
            if s.get("delivered_state") != s.get("desired_state"):
                lease = s.get("lease_deadline") or 0
                sending_pid = s.get("sending_pid")
                if lease and (now_wall < lease) and is_pid_alive(sending_pid):
                    continue  # Active sender already in progress
                payload = s.get("desired_payload")
                if payload:
                    success, is_4xx = post_bartender_event(payload, bridge_url=bridge_url)
                    if success:
                        s["delivered_state"] = s.get("desired_state")
                        s.pop("last_error", None)
                        data["last_successful_delivery"] = now_wall
                        data["consecutive_failures"] = 0
                        if s.get("desired_state") == "Ended":
                            sessions.pop(sid, None)
                    elif is_4xx:
                        s["last_error"] = "4xx rejected"
                        if s.get("desired_state") == "Ended":
                            sessions.pop(sid, None)
                    else:
                        s["last_error"] = "retryable delivery error"
                        data["consecutive_failures"] = data.get("consecutive_failures", 0) + 1
        cache_mgr.save(data)


def run_cleanup(bridge_url: str | None = None) -> bool:
    touch_heartbeat()
    cache_mgr = BoundedSessionCache(get_state_dir())
    now = time.time()
    all_cleared = True
    with cache_mgr as data:
        sessions = data.get("sessions", {})
        for session_id, info in list(sessions.items()):
            payload = {"state": "Ended", "agent": info.get("agent", "Herdr"), "session_id": session_id}
            success, is_4xx = post_bartender_event(payload, bridge_url=bridge_url)
            if success or is_4xx:
                sessions.pop(session_id, None)
            else:
                all_cleared = False
                info["desired_state"] = "Ended"
                info["delivery_attempts"] = info.get("delivery_attempts", 0) + 1
                info["last_attempt"] = now
        cache_mgr.save(data)
    return all_cleared


def handle_agent_status_changed(event_data: dict, context: dict, bridge_url: str | None = None):
    touch_heartbeat()
    raw_pane = event_data.get("pane_id") or context.get("focused_pane_id")
    workspace_id = event_data.get("workspace_id") or context.get("workspace_id") or "w1"
    agent_status = event_data.get("agent_status")

    if not raw_pane:
        return

    canonical_pane = normalize_pane_id(raw_pane, workspace_id)
    host = get_sanitized_hostname()
    session_id = f"herdr:{host}:{canonical_pane}"

    cache_mgr = BoundedSessionCache(get_state_dir())

    # 1. Critical section: Update cache & manage per-session monotonic lease
    with cache_mgr as data:
        sessions = data.get("sessions", {})
        raw_agent = event_data.get("agent")
        if not raw_agent and context.get("focused_pane_id") == canonical_pane:
            raw_agent = context.get("focused_pane_agent")

        # Anti-Flap Rule: Herdr may report unknown transiently during reattach/startup.
        # Do not evict; retain existing session state until pane.closed is received.
        if agent_status == "unknown":
            log_debug(f"Debouncing transient unknown status for pane {canonical_pane}")
            return

        # Qualification filter: pane must have agent metadata or already exist in cache
        if not raw_agent and session_id not in sessions:
            return

        mapped_state = STATUS_MAP.get(agent_status)
        if not mapped_state:
            return

        agent_name = format_agent_name(raw_agent or sessions.get(session_id, {}).get("raw_agent"))
        raw_title = event_data.get("title") or context.get("workspace_label") or f"Pane {canonical_pane}"
        title = sanitize_title(raw_title)
        cwd = context.get("focused_pane_cwd") or context.get("workspace_cwd") or ""
        tab_id = event_data.get("tab_id") or context.get("tab_id")

        now_wall = time.time()
        event_seq = event_data.get("seq") or now_wall
        prev_seq = sessions.get(session_id, {}).get("seq", 0)
        # Drop stale out-of-order events
        if prev_seq > event_seq:
            return

        payload = {
            "state": mapped_state,
            "agent": agent_name,
            "session_id": session_id,
            "title": title,
            "cwd": cwd,
            "terminal": "Herdr",
            "event": "pane.agent_status_changed",
        }

        session_record = sessions.setdefault(session_id, {})
        session_record.update({
            "pane_id": canonical_pane,
            "workspace_id": workspace_id,
            "tab_id": tab_id,
            "host": host,
            "agent": agent_name,
            "raw_agent": raw_agent,
            "title": title,
            "cwd": cwd,
            "desired_state": mapped_state,
            "desired_payload": payload,
            "seq": event_seq,
        })

        active_lease = session_record.get("lease_deadline") or 0
        sending_pid = session_record.get("sending_pid")
        # Wall clock sanity: if lease_deadline is > 5s in future, consider invalid
        if active_lease and (active_lease > now_wall + 5.0):
            active_lease = 0

        if active_lease and (now_wall < active_lease) and is_pid_alive(sending_pid):
            # Active in-flight transmission for this session; stage into queued_payload and exit immediately
            session_record["queued_payload"] = payload
            cache_mgr.save(data)
            return

        # Claim sending lease with unique lease token
        my_token = f"{os.getpid()}:{now_wall}"
        session_record["lease_token"] = my_token
        session_record["sending_pid"] = os.getpid()
        session_record["lease_deadline"] = now_wall + 2.0
        session_record["queued_payload"] = None
        cache_mgr.save(data)
        current_payload = payload
        transmitting_state = mapped_state
        transmitting_seq = event_seq

    # 2. Outside lock: transmit and drain queue with lease ownership verification
    while current_payload:
        success, is_4xx = post_bartender_event(current_payload, bridge_url=bridge_url)
        with cache_mgr as data:
            s = data.get("sessions", {}).get(session_id)
            if not s:
                break
            # Ownership verification: ensure our lease token was not superseded
            if s.get("lease_token") != my_token:
                log_debug(f"Lease token superseded for {session_id}, exiting drain loop")
                break

            if success:
                s["delivered_state"] = transmitting_state
                s["delivered_seq"] = transmitting_seq
                s.pop("last_error", None)
                data["last_successful_delivery"] = time.time()
                data["consecutive_failures"] = 0
            else:
                s["last_error"] = "4xx rejected" if is_4xx else "network error"
                data["consecutive_failures"] = data.get("consecutive_failures", 0) + 1

            next_payload = s.get("queued_payload")
            if next_payload and time_remaining() > 0.4:
                s["desired_payload"] = next_payload
                s["queued_payload"] = None
                s["lease_deadline"] = time.time() + 2.0
                cache_mgr.save(data)
                current_payload = next_payload
                transmitting_state = next_payload.get("state")
                transmitting_seq = time.time()
            else:
                s["sending_pid"] = None
                s["lease_token"] = None
                s["lease_deadline"] = None
                cache_mgr.save(data)
                current_payload = None


def handle_pane_closed(event_data: dict, context: dict, bridge_url: str | None = None):
    touch_heartbeat()
    raw_pane = event_data.get("pane_id") or context.get("focused_pane_id")
    workspace_id = event_data.get("workspace_id") or context.get("workspace_id")
    if not raw_pane:
        return

    canonical_pane = normalize_pane_id(raw_pane, workspace_id)
    cache_mgr = BoundedSessionCache(get_state_dir())
    target_sessions = []

    with cache_mgr as data:
        sessions = data.get("sessions", {})
        for sid, info in list(sessions.items()):
            if info.get("pane_id") == canonical_pane or sid.endswith(f":{canonical_pane}"):
                target_sessions.append((sid, info))
                info["desired_state"] = "Ended"
        if target_sessions:
            cache_mgr.save(data)

    # Dispatch Ended outside lock
    for sid, info in target_sessions:
        success, is_4xx = post_bartender_event(
            {"state": "Ended", "agent": info.get("agent", "Herdr"), "session_id": sid},
            bridge_url=bridge_url
        )
        if success or is_4xx:
            with cache_mgr as data:
                data.get("sessions", {}).pop(sid, None)
                cache_mgr.save(data)


def handle_tab_closed(event_data: dict, context: dict, bridge_url: str | None = None):
    touch_heartbeat()
    tab_id = event_data.get("tab_id") or context.get("tab_id")
    if not tab_id:
        return

    cache_mgr = BoundedSessionCache(get_state_dir())
    target_sessions = []

    with cache_mgr as data:
        sessions = data.get("sessions", {})
        for sid, info in list(sessions.items()):
            if info.get("tab_id") == tab_id or (tab_id.endswith(str(info.get("tab_id")))):
                target_sessions.append((sid, info))
                info["desired_state"] = "Ended"
        if target_sessions:
            cache_mgr.save(data)

    for sid, info in target_sessions:
        success, is_4xx = post_bartender_event(
            {"state": "Ended", "agent": info.get("agent", "Herdr"), "session_id": sid},
            bridge_url=bridge_url
        )
        if success or is_4xx:
            with cache_mgr as data:
                data.get("sessions", {}).pop(sid, None)
                cache_mgr.save(data)


def handle_workspace_closed(event_data: dict, context: dict, bridge_url: str | None = None):
    touch_heartbeat()
    workspace_id = event_data.get("workspace_id") or context.get("workspace_id")
    if not workspace_id:
        return

    cache_mgr = BoundedSessionCache(get_state_dir())
    target_sessions = []

    with cache_mgr as data:
        sessions = data.get("sessions", {})
        for sid, info in list(sessions.items()):
            if info.get("workspace_id") == workspace_id or f":{workspace_id}:" in sid:
                target_sessions.append((sid, info))
                info["desired_state"] = "Ended"
        if target_sessions:
            cache_mgr.save(data)

    for sid, info in target_sessions:
        success, is_4xx = post_bartender_event(
            {"state": "Ended", "agent": info.get("agent", "Herdr"), "session_id": sid},
            bridge_url=bridge_url
        )
        if success or is_4xx:
            with cache_mgr as data:
                data.get("sessions", {}).pop(sid, None)
                cache_mgr.save(data)


# ==============================================================================
# Testing & Verification Harness
# ==============================================================================

class MockBartenderHandler(BaseHTTPRequestHandler):
    sessions = {}
    history = []
    delay = 0.0
    return_code = 200

    def log_message(self, format, *args):
        pass

    def do_GET(self):
        if self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"ok": True, "port": self.server.server_port, "sessions": len(self.sessions)}).encode())
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        if self.delay > 0:
            time.sleep(self.delay)

        if self.return_code != 200:
            self.send_response(self.return_code)
            self.end_headers()
            return

        if self.path == "/event":
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length).decode("utf-8")
            data = json.loads(body)
            MockBartenderHandler.history.append(data)
            sid = data.get("session_id")
            state = data.get("state")
            if state == "Ended":
                MockBartenderHandler.sessions.pop(sid, None)
            else:
                MockBartenderHandler.sessions[sid] = data
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"ok":true}')
        else:
            self.send_response(404)
            self.end_headers()


def run_unit_tests():
    print("=== Running Comprehensive Hardened Unit Test Suite ===")
    MockBartenderHandler.sessions = {}
    MockBartenderHandler.history = []
    MockBartenderHandler.delay = 0.0
    MockBartenderHandler.return_code = 200

    server = HTTPServer(("127.0.0.1", 0), MockBartenderHandler)
    mock_port = server.server_port
    server_thread = threading.Thread(target=server.serve_forever, daemon=True)
    server_thread.start()

    mock_url = f"http://127.0.0.1:{mock_port}"
    os.environ["NOTCHBAR_AGENTS_HOST"] = "127.0.0.1"
    os.environ["NOTCHBAR_AGENTS_PORT"] = str(mock_port)

    # 1. Bridge health check
    health = check_bridge_health(bridge_url=mock_url)
    assert health and health["ok"] is True, "Health check failed"
    print("[PASS] Mock bridge health check")

    # 2. Lifecycle transitions
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "w1:p1", "workspace_id": "w1", "agent": "claude", "title": "Unit test turn"},
        {"tab_id": "w1:t1"},
        bridge_url=mock_url
    )
    assert len(MockBartenderHandler.sessions) == 1
    assert list(MockBartenderHandler.sessions.values())[0]["state"] == "Working"
    print("[PASS] Working status transition")

    handle_agent_status_changed(
        {"agent_status": "blocked", "pane_id": "w1:p1", "workspace_id": "w1", "agent": "claude"},
        {"tab_id": "w1:t1"},
        bridge_url=mock_url
    )
    assert list(MockBartenderHandler.sessions.values())[0]["state"] == "Waiting"
    print("[PASS] Blocked -> Waiting attention transition")

    # Anti-Flap: unknown status does NOT evict active session
    handle_agent_status_changed(
        {"agent_status": "unknown", "pane_id": "w1:p1", "workspace_id": "w1"},
        {"tab_id": "w1:t1"},
        bridge_url=mock_url
    )
    assert len(MockBartenderHandler.sessions) == 1
    print("[PASS] Unknown status debounced (anti-flap)")

    # 3. Cascading container closures
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "wTest:pA", "workspace_id": "wTest", "agent": "codex"},
        {"tab_id": "wTest:tA"},
        bridge_url=mock_url
    )
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "wTest:pB", "workspace_id": "wTest", "agent": "claude"},
        {"tab_id": "wTest:tB"},
        bridge_url=mock_url
    )
    assert len(MockBartenderHandler.sessions) == 3

    handle_tab_closed({"tab_id": "wTest:tA"}, {}, bridge_url=mock_url)
    assert len(MockBartenderHandler.sessions) == 2

    handle_workspace_closed({"workspace_id": "wTest"}, {}, bridge_url=mock_url)
    assert len(MockBartenderHandler.sessions) == 1

    handle_pane_closed({"pane_id": "w1:p1", "workspace_id": "w1"}, {}, bridge_url=mock_url)
    assert len(MockBartenderHandler.sessions) == 0
    print("[PASS] Container cascades (pane, tab & workspace)")

    # 4. Out-of-order monotonic sequencing
    t_base = time.time()
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "w1:pSeq", "workspace_id": "w1", "agent": "claude", "seq": t_base + 10},
        {},
        bridge_url=mock_url
    )
    # Stale event with older seq should be rejected
    handle_agent_status_changed(
        {"agent_status": "idle", "pane_id": "w1:pSeq", "workspace_id": "w1", "agent": "claude", "seq": t_base + 2},
        {},
        bridge_url=mock_url
    )
    cache_mgr = BoundedSessionCache(get_state_dir())
    with cache_mgr as data:
        sid = f"herdr:{get_sanitized_hostname()}:w1:pSeq"
        assert data["sessions"][sid]["desired_state"] == "Working", "Stale event must not overwrite state"
    print("[PASS] Out-of-order monotonic event suppression")

    # 5. Failed Ended & Active Supersession
    MockBartenderHandler.return_code = 500
    handle_pane_closed({"pane_id": "w1:pSeq", "workspace_id": "w1"}, {}, bridge_url=mock_url)
    with cache_mgr as data:
        assert data["sessions"][sid]["desired_state"] == "Ended", "Failed Ended must mark desired_state=Ended"
    print("[PASS] Failed Ended recorded in unified cache")

    # A new turn arrives for the same pane -> Active Supersession
    MockBartenderHandler.return_code = 200
    handle_agent_status_changed(
        {"agent_status": "working", "pane_id": "w1:pSeq", "workspace_id": "w1", "agent": "claude", "seq": t_base + 20},
        {},
        bridge_url=mock_url
    )
    with cache_mgr as data:
        assert data["sessions"][sid]["desired_state"] == "Working", "Active event must supersede Ended"
    print("[PASS] Active event supersedes and cancels pending Ended")

    # 6. HTTP 4xx drops session immediately (non-retryable)
    MockBartenderHandler.return_code = 400
    handle_pane_closed({"pane_id": "w1:pSeq", "workspace_id": "w1"}, {}, bridge_url=mock_url)
    with cache_mgr as data:
        assert sid not in data["sessions"], "HTTP 4xx must evict Ended session immediately"
    print("[PASS] HTTP 4xx non-retryable eviction")

    # 7. Corrupt cache quarantine with session ID salvage
    MockBartenderHandler.return_code = 200
    cache_file = get_state_dir() / "active-sessions.json"
    with open(cache_file, "w") as f:
        f.write('{"sessions": {"herdr:macbook:w1:pSalvage": {"state": "Working"}}, invalid json...')
    with cache_mgr as data:
        assert "herdr:macbook:w1:pSalvage" in data.get("sessions", {}), "Expected candidate ID to be salvaged"
    corrupt_files = list(get_state_dir().glob("active-sessions.json.corrupt.*"))
    assert len(corrupt_files) > 0, "Expected corrupt cache to be quarantined"
    print("[PASS] Corrupt cache quarantine and session salvage under lock")

    # 8. Process deadline enforcement under slow network
    MockBartenderHandler.delay = 3.0
    t0 = time.monotonic()
    post_bartender_event({"state": "Working", "agent": "Test", "session_id": "timeout-test"}, timeout=0.5, bridge_url=mock_url)
    elapsed = time.monotonic() - t0
    assert elapsed < 1.0, f"Expected bounded exit, took {elapsed}s"
    print(f"[PASS] Bounded request timeout enforcement ({elapsed:.2f}s < 1.0s)")

    MockBartenderHandler.delay = 0.0
    server.shutdown()
    print("=== ALL COMPREHENSIVE UNIT TESTS PASSED ===")


def run_live_test():
    print(f"Checking Bartender bridge at {get_bridge_url()}...")
    health = check_bridge_health()
    if not health:
        print("[-] Error: Bartender bridge not reachable. Make sure Bartender 6 is running with Top Shelf enabled.")
        sys.exit(1)
    print(f"[+] Bartender bridge is healthy: {health}")

    host = get_sanitized_hostname()
    test_session = f"herdr:{host}:test_workspace:test_pane_1"
    print("\n1. Emitting 'Working' state...")
    post_bartender_event({
        "state": "Working",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
        "title": "Unit test running in Herdr",
        "terminal": "Herdr",
    })
    print("   Sent Working. Top Shelf should show active spinner.")

    time.sleep(1.0)

    print("\n2. Emitting 'Waiting' state (Awaiting input / attention)...")
    post_bartender_event({
        "state": "Waiting",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
        "title": "Awaiting user confirmation in Herdr",
        "terminal": "Herdr",
    })
    print("   Sent Waiting. Top Shelf NotchBar should highlight attention banner.")

    time.sleep(1.0)

    print("\n3. Emitting 'Done' state...")
    post_bartender_event({
        "state": "Done",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
        "title": "Task completed successfully",
        "terminal": "Herdr",
    })
    print("   Sent Done. Top Shelf should show completion.")

    time.sleep(1.0)

    print("\n4. Emitting 'Ended' state (Pane closed)...")
    post_bartender_event({
        "state": "Ended",
        "agent": "Claude (Herdr)",
        "session_id": test_session,
    })
    print("   Sent Ended. Session removed from Top Shelf.")

    final_health = check_bridge_health()
    print(f"\n[+] Live test complete! Final bridge health: {final_health}")


def main():
    args = sys.argv[1:]

    if "--unit-test" in args:
        run_unit_tests()
        return

    if "--test" in args:
        run_live_test()
        return

    if "--health" in args:
        h = check_bridge_health()
        print(json.dumps(h or {"error": "unreachable"}))
        return

    if "--cleanup" in args:
        ok = run_cleanup()
        sys.exit(0 if ok else 1)

    if "--sessions" in args:
        cache_mgr = BoundedSessionCache(get_state_dir())
        with cache_mgr as data:
            print(json.dumps(data, indent=2))
        return

    # Normal Herdr event dispatch
    arm_watchdog()
    touch_heartbeat()
    event_name = os.environ.get("HERDR_PLUGIN_EVENT", "")
    event_json_raw = os.environ.get("HERDR_PLUGIN_EVENT_JSON", "{}")
    context_json_raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON", "{}")

    try:
        envelope = json.loads(event_json_raw)
    except Exception:
        envelope = {}

    try:
        context = json.loads(context_json_raw)
    except Exception:
        context = {}

    data = envelope.get("data", {})

    if event_name == "pane.agent_status_changed":
        handle_agent_status_changed(data, context)
    elif event_name == "pane.closed":
        handle_pane_closed(data, context)
    elif event_name == "tab.closed":
        handle_tab_closed(data, context)
    elif event_name == "workspace.closed":
        handle_workspace_closed(data, context)


if __name__ == "__main__":
    main()
